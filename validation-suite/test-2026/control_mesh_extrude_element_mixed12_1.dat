( F5 T4 U9c: control_mesh_extrude_element 10 -prism12 on a mixed mesh: a
  -quad4 and two -tria6, z 0 2, element groups 0 -> 3 and 1 -> 4. The quad4
  gives a -hex8, the tria6 -prism12, no mid planes {11 nodes per plane}.
  Mesh = Professional 02-08-2026 on this file. Self-weight rho 1, g 1, the
  base fixed: the summed base reaction is -V = -4 {unit squares x height
  2}. )
echo -no
number_of_space_dimensions 3
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0 0
node 2 0.5 0 0
node 3 1 0 0
node 4 0 0.5 0
node 5 0.5 0.5 0
node 6 0 1 0
node 7 1 0.5 0
node 8 1 1 0
node 9 0.5 1 0
element 1 -tria6 1 2 3 4 5 6
element 2 -tria6 3 7 8 5 9 6
node 10 2 0 0
node 11 2 1 0
element 3 -quad4 3 10 8 11
element_group 3 1
group_type -ra 3 4 -ra -materi
group_materi_elasti_young -ra 3 4 -ra 1.e6
group_materi_elasti_poisson -ra 3 4 -ra 0.2
group_materi_density -ra 3 4 -ra 1.
group_materi_memory -ra 3 4 -ra -total_linear
control_mesh_extrude 10 0. 2.
control_mesh_extrude_element 10 -prism12
control_mesh_extrude_element_group_new 10 0 1  3  4
force_gravity 0. 0. -1.
geometry_quadrilateral 1  0. 0. 0.  2. 0. 0.  0. 1. 0.  2. 1. 0.  1.e-5
bounda_dof 20 -geometry_quadrilateral 1 -velx -vely -velz
bounda_time 20 0.
control_timestep 30 1. 1.
control_print_database 30 -separate_index
end_data
