( control_mesh_truss_distribute_mpc_exact_minimal_length: truss 2..10.5
  over bars of length 10, minimal length 1: the last piece 10..10.5 is not
  generated, the end node 6 is deleted, the truss ends at the new node 7
  at x=10 [Professional 02-08-2026: the same, its new node is 8].
)
echo -no
number_of_space_dimensions 1
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0
node 2 10
node 3 20
node 4 30
element 1 -bar2 1 2
element 2 -bar2 2 3
element 3 -bar2 3 4
node 5 2
node 6 10.5
element 4 -truss 5 6
element_group 4 1
group_type 1 -truss
group_truss_area 1 0.1
group_truss_memory 1 -total_linear
group_truss_elasti_young 1 1.
control_mesh_truss_distribute_mpc 10 -yes
control_mesh_truss_distribute_mpc_exact 10 -yes
control_mesh_truss_distribute_mpc_exact_minimal_length 10 1.
end_data
