(
control_mpc_element_group default -no [manual 6.256]: the records are only
re-created when the mesh changes, so the geometry moving onto the nodes
[change_dataitem] adds no mpc. The Professional 02-08-2026 re-creates them
every timestep [DIVERGENCES CONTROL-MPC-ELEMENT-GROUP].
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_stress
end_initia
node 1 0.0 0.0
node 2 0.0 1.0
node 3 1.0 0.0
node 4 1.0 1.0
element 1 -quad4 1 2 3 4
node 5 1.0 0.0
node 6 1.0 0.5
node 7 1.0 1.0
node 8 2.0 0.0
node 9 2.0 0.5
node 10 2.0 1.0
element 2 -quad4 5 6 8 9
element 3 -quad4 6 7 9 10
element_group 1 1
element_group 2 2
element_group 3 2
group_type 1  -materi
group_materi_elasti_young 1  1.0
group_type 2  -materi
group_materi_elasti_young 2  1.0
mpc_element_group 10 2 1
mpc_element_group_dof 10 -velx -vely
geometry_line 1 5.0 -1.0 5.0 2.0 1.e-6
mpc_element_group_geometry 10 -geometry_line 1
change_dataitem 0 -geometry_line 1 0 -use
change_dataitem_time 0 0. 5. 1.2 5. 1.5 1. 100. 1.
change_dataitem 1 -geometry_line 1 2 -use
change_dataitem_time 1 0. 5. 1.2 5. 1.5 1. 100. 1.

bounda_dof  10  -ra 1 2 -ra -velx -vely
bounda_dof  20  -ra 8 9 10 -ra -velx -vely
control_timestep  10  1. 1.0
control_timestep  20  1. 2.0
control_print     20  -time_current -node_dof
end_data
