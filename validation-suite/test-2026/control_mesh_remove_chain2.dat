( F5 T4 U9e: as control_mesh_remove_chain1 at an index without timestep:
  element 2 gives nodes 7 8 the mean of nodes 4 5 (stresses times 0.5);
  element 3 has no active node, so nodes 10 11 get zero dofs, and nodes
  7 8 keep the values of element 2, the first one (= Professional
  02-08-2026). )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0. 0.
node 2 1. 0.
node 4 0. 1.
node 5 1. 1.
node 7 0. 2.
node 8 1. 2.
node 10 0. 3.
node 11 1. 3.
element 1 -quad4 1 2 4 5
element 2 -quad4 4 5 7 8
element 3 -quad4 7 8 10 11
element 4 -quad4 4 5 7 8
element 5 -quad4 7 8 10 11
element_group -ra 2 3 -ra 2
element_group -ra 4 5 -ra 1
group_type -ra 0 1 2 -ra -materi
group_materi_elasti_young -ra 0 1 2 -ra 1000.
group_materi_elasti_poisson -ra 0 1 2 -ra 0.2
group_materi_density -ra 0 1 2 -ra 1.
force_gravity 0. -10.
bounda_dof 1 -ra 1 2 -ra -velx -vely
control_mesh_remove 10 -method1 2 1
control_mesh_remove_really 10 -no
control_timestep 10 1. 1.
control_print_database 10 -yes
control_mesh_delete_element 15 4 5
control_timestep 15 1. 1.
control_print_database 15 -yes
control_mesh_remove 20 -method1 7 8
control_mesh_remove_really_activate_factor 20 0.5
control_print_database 20 -yes
end_data
