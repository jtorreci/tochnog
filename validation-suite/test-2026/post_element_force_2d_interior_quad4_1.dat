( C84 {F4 T6f, 2026-10-17}: post_element_force at an INTERIOR section
  {manual 6.933: without post_element_force_normal the elements on both
  sides are used if present}. The 4x1 strip of quad4 elements of
  post_element_force_2d_quad4_1, section at x=2 {normal 1 0, shear0 0 1,
  middle 2 0.5}. The result is the mean of the positive-side resultant
  and the negated negative-side resultant: normal 100, shear0 10,
  moment0 -20 {the plain sum of both sides cancels to 0}. Targets: the
  Professional 02-08-2026 on this file {tolerance 4e-6 of
  max{|value|,1}}; the Professional corpus force14/force15 {quad9
  beam, plane and axisymmetric, shear -500 / -235619} check the same
  rule with a load at the section nodes. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 2 0
node 4 3 0
node 5 4 0
node 6 0 1
node 7 1 1
node 8 2 1
node 9 3 1
node 10 4 1
element 1 -quad4 1 2 6 7
element 2 -quad4 2 3 7 8
element 3 -quad4 3 4 8 9
element 4 -quad4 4 5 9 10
group_type 0 -materi
group_materi_elasti_young 0 1.e4
group_materi_elasti_poisson 0 0.
group_materi_memory 0 -total_linear
geometry_line 1 2. 0. 2. 1. 1.e-5
post_element_force 10 1. 0. 0. 1. 2. 0.5
post_element_force_geometry 10 -geometry_line 1
bounda_dof 20 1 -velx
bounda_time 20 0.
bounda_dof 21 1 -vely
bounda_time 21 0.
bounda_dof 22 6 -velx
bounda_time 22 0.
bounda_dof 23 6 -vely
bounda_time 23 0.
bounda_force 1 5 -velx
bounda_time 1 50.
bounda_force 2 5 -vely
bounda_time 2 5.
bounda_force 3 10 -velx
bounda_time 3 50.
bounda_force 4 10 -vely
bounda_time 4 5.
control_timestep 30 1. 1.

target_item 40 -post_element_force_result 10 0
target_value 40 100 4.0e-04
target_item 41 -post_element_force_result 10 1
target_value 41 10 4.0e-05
target_item 42 -post_element_force_result 10 2
target_value 42 -20 8.0e-05
end_data
