(F5 T3 D3: nu 0.49 gives a negative b2 {Professional sigyy -0.3667830,
 e 0.5661948; GNU -0.3668340, 0.5661903}.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
materi_strain_total
materi_plasti_hypo_history
end_initia


node 1  0.00 0.00
node 2  1.00 0.00
node 3  0.00 1.00
node 4  1.00 1.00

element 1 -quad4 1 2 3 4

(left edge)
geometry_line 0  0.00 0.00 0.00 1.00 1.e-5
(lower edge)
geometry_line 1  0.00 0.00 1.00 0.00 1.e-5
(upper edge)
geometry_line 2  0.00 1.00 1.00 1.00 1.e-5
(right edge)
geometry_line 3  1.00 0.00 1.00 1.00 1.e-5

force_edge_normal_geometry   0  -geometry_line 3
force_edge_normal            0  -0.2

bounda_dof     0  -geometry_line 0 -velx
bounda_time    0  0. 0. 1.e10 0.
bounda_dof     1  -geometry_line 1 -vely
bounda_time    1  0. 0. 1.e10 0.
bounda_dof     2  -geometry_line 2 -vely
bounda_time    2  0. -1. 1.e10 -1.

group_type           0  -materi
group_materi_memory  0  -total_linear
group_materi_plasti_hypo_void_ratio_linear 0  -yes
group_materi_plasti_hypo_wolffersdorff 0  
                        33.00001987 (phic deg)
                        1000. (hs MPa)
                        0.25  (n)
                        0.95  (ec)
                        0.55  (ed)
                        1.05  (ei)
                        0.25  (alpha)
                        1.00  (beta)
group_materi_plasti_hypo_wolffersdorff_niemunis 0  0.49 5.

post_point 1 0.05 0.05

control_reset_dof             2  -hyhis0 (initial void ratio)
control_reset_value_constant  2  0.645
control_reset_dof             3  -sigxx -sigyy -sigzz (initial stresses)
control_reset_value_constant  3  -0.2

control_print_history   10  -post_point_dof 1 -eptyy
			    -post_point_dof 1 -sigyy
			    -post_point_dof 1 -eptxx
			    -post_point_dof 1 -sigxx
			    -post_point_dof 1 -hyhis0

control_timestep        20  1.e-4 0.1
control_print           20  -time_current -post_node_rhside_ratio -post_point_dof
control_print_history   20  -post_point_dof 1 -eptyy
			    -post_point_dof 1 -sigyy
			    -post_point_dof 1 -eptxx
			    -post_point_dof 1 -sigxx
			    -post_point_dof 1 -hyhis0

target_item 0 -post_point_dof 1 -sigyy
target_value 0 -0.3668340 1.e-6
target_item 1 -post_point_dof 1 -hyhis0
target_value 1 0.5661903 1.e-6
end_data
