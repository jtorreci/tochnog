(
mpc_element_group_coord_geometry -yes [manual 6.861] with
mpc_element_group_closest -yes and mpc_element_group_geometry: node 5 at
y = 0 lies below the lowest element_group_1 node [y = 0.25] and gets no mpc;
nodes 6 and 7 are tied. Records equal the Professional 02-08-2026 ones
[build_safe mpc_check].
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_stress
end_initia
node 1 0.0 0.25
node 2 0.0 1.0
node 3 1.0 0.25
node 4 1.0 1.0
element 1 -quad4 1 2 3 4
node 5 1.0 0.0
