( group_time_fill (manual 6.770), F5 T5 U7: as group_time_fill1 with
  -materi -groundflow groups, wet/dry density 2.0/1.5 and a static phreatic
  level at y = 2. The total (pore) pressure of the upper element is scaled
  with the filling factor like its density. Professional 02-08-2026 at t = 1
  (factor 0.25): disy 0 at y = 1 and -0.00625 at y = 2 (GNU without the
  pressure scaling: -0.0025).
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
node 5 0 2
node 6 1 2
element 1 -quad4 1 2 3 4
element 2 -quad4 3 4 5 6
element_group 2 1
group_type 0 -materi -groundflow
group_materi_elasti_young 0 1000
group_materi_elasti_poisson 0 0
group_materi_memory 0 -total_linear
group_materi_density_groundflow 0 2.0 1.5
group_type 1 -materi -groundflow
group_materi_elasti_young 1 1000
group_materi_elasti_poisson 1 0
group_materi_memory 1 -total_linear
group_materi_density_groundflow 1 2.0 1.5
group_time_fill 1 0.5 2.5 100
force_gravity 0 -10
groundflow_density 1.
groundflow_phreatic_level 2.
groundflow_phreatic_level_static -yes
post_calcul -groundflow_pressure -total_pressure
bounda_dof 0 -ra 1 2 -ra -velx -vely
bounda_dof 1 -ra 3 4 5 6 -ra -velx
control_timestep 10 0.25 0.5
control_timestep 20 0.25 0.5
target_item    1  -node_dof 3 -disy
target_value   1  0. 1.e-10
target_item    2  -node_dof 5 -disy
target_value   2  -6.25e-3 1.e-10
end_data
