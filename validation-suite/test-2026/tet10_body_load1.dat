( F4 T4 / C31: unit cube hex8, h- and p-refined and split into 48 tet10,
  bottom fixed, gravity -1, E 1, density 1: sigzz at the bottom = -1
  exactly, sigxx = sigyy = 0 [the Professional 02-08-2026 `tet10_2`].
  Keast 5-point rule + linear least-squares recovery: sigzz
  -1.00000000515. Old GNU [nodal rule, degree 1]: sigzz -0.894. )
echo -no
number_of_space_dimensions 3
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  0.0 0.0 0.0
node 2  1.0 0.0 0.0
node 3  0.0 1.0 0.0
node 4  1.0 1.0 0.0
node 5  0.0 0.0 1.0
node 6  1.0 0.0 1.0
node 7  0.0 1.0 1.0
node 8  1.0 1.0 1.0
element 1  -hex8 1 2 3 4 5 6 7 8

start_define
  lower_edge geometry_quadrilateral 1
end_define
start_define
  upper_edge geometry_quadrilateral 2
end_define

lower_edge 0. 0. 0. 1. 0. 0. 0. 1. 0. 1. 1. 0. 1.e-5
upper_edge 0. 0. 1. 1. 0. 1. 0. 1. 1. 1. 1. 1. 1.e-5

group_type 0  -materi
group_materi_elasti_young 0  1.0
group_materi_density 0  1.0
group_materi_memory 0  -total_linear

bounda_dof   0   -lower_edge -velx -vely -velz

post_point       1  0.1 0.1 0.0

force_gravity 0. 0. -1.

control_mesh_refine_globally 10  -h_refinement
control_mesh_refine_globally 11  -p_refinement

control_mesh_split           20  -yes

control_timestep             30  1. 1.
target_item  1 -post_point_dof 1 -sigxx
target_value 1 0. 1.e-6
target_item  2 -post_point_dof 1 -sigyy
target_value 2 0. 1.e-6
target_item  3 -post_point_dof 1 -sigzz
target_value 3 -1. 1.e-6
end_data
