( C86 {F4 T6f, 2026-10-19}: post_element_force at an interior section
  {x=2, middle 2 0.5} of the C84 4x1 quad4 strip {fixed at x=0, loads velx
  50 and vely 5 at the x=4 corners} with two -truss elements 1-3 {negative
  side} and 3-5 {positive side} meeting at the section node 3. Each truss
  contributes on the side of its centroid and the result is the mean of
  both sides: the Professional 02-08-2026 gives normal 100, shear0 10,
  moment0 -20 {continuum alone 55 / 10 / 2.5}. Targets: the Professional. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 2 0
node 4 3 0
node 5 4 0
node 6 0 1
node 7 1 1
node 8 2 1
node 9 3 1
node 10 4 1
element 1 -quad4 1 2 6 7
element 2 -quad4 2 3 7 8
element 3 -quad4 3 4 8 9
element 4 -quad4 4 5 9 10
group_type 0 -materi
group_materi_elasti_young 0 1.e4
group_materi_elasti_poisson 0 0.
group_materi_memory 0 -total_linear
geometry_line 1 2. 0. 2. 1. 1.e-5
post_element_force 10 1. 0. 0. 1. 2. 0.5
post_element_force_geometry 10 -geometry_line 1
bounda_dof 20 1 -velx
bounda_time 20 0.
bounda_dof 21 1 -vely
bounda_time 21 0.
bounda_dof 22 6 -velx
bounda_time 22 0.
bounda_dof 23 6 -vely
bounda_time 23 0.
bounda_force 1 5 -velx
bounda_time 1 50.
bounda_force 2 5 -vely
bounda_time 2 5.
bounda_force 3 10 -velx
bounda_time 3 50.
bounda_force 4 10 -vely
bounda_time 4 5.
element 5 -truss 1 3
element 6 -truss 3 5
element_group 5 1
element_group 6 1
group_type 1 -truss
group_truss_area 1 1.
group_truss_elasti_young 1 1.e4
control_timestep 30 1. 1.
target_item 40 -post_element_force_result 10 0
target_value 40 100 4.0e-04
target_item 41 -post_element_force_result 10 1
target_value 41 10 4.0e-05
target_item 42 -post_element_force_result 10 2
target_value 42 -20 8.0e-05
end_data
