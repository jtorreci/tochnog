( F3/C8: default mesh is -fixed_in_space (manual Professional 6.806).
  Single quad4 rigidly rotated (omega 1, t 0.5) with velocity-only
  kinematics, default memory, NO mesh record. On a fixed mesh the
  constant rigid-rotation velocity field gives no strain, so all stresses
  are 0; Professional 02-08-2026 gives 0. Before F3 GNU defaulted to
  -follow_material and gave sigxx = sigyy = 0.109567. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_strain_total
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1.0
group_materi_elasti_poisson 0 0.0
bounda_dof 0 1 -velx
bounda_time 0 0.0
bounda_dof 1 1 -vely
bounda_time 1 0.0
bounda_dof 2 2 -velx
bounda_time 2 0.0
bounda_dof 3 2 -vely
bounda_time 3 1.0
bounda_dof 4 3 -velx
bounda_time 4 -1.0
bounda_dof 5 3 -vely
bounda_time 5 0.0
bounda_dof 6 4 -velx
bounda_time 6 -1.0
bounda_dof 7 4 -vely
bounda_time 7 1.0
control_timestep 0 0.01 0.5
control_timestep_iterations 0 20
target_item 0  -node_dof 4 -sigxx
target_value 0  0.0 1e-06
target_item 1  -node_dof 4 -sigyy
target_value 1  0.0 1e-06
target_item 2  -node_dof 4 -sigxy
target_value 2  0.0 1e-06
end_data
