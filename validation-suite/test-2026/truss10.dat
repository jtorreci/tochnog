( Copy of the Professional 02-08-2026 example test/other/truss10.dat
  [control_mesh_truss_distribute_mpc 6.245, no time step]. The truss is
  recreated as element 4, node 4 is tied to the first bar, node 5 lies in
  the air and is not tied; .dbs = Professional [elem_check / mpc_check]. )
( Automatic distribution of truss. )

echo -no
number_of_space_dimensions 1
materi_velocity
materi_displacement
materi_stress
end_initia

node 1   0
node 2  10
node 3  20
node 4   5
node 5  25
element 1  -bar2 1 2
element 2  -bar2 2 3
element 3  -truss 4 5
element_group 3  1

group_type 1  -truss
group_truss_area 1  0.1
group_truss_memory 1  -total_linear
group_truss_elasti_young 1  1.

control_mesh_truss_distribute_mpc 10 -yes
control_mesh_truss_distribute_mpc_air 10 -yes
control_mesh_truss_distribute_mpc_element_group_truss 10 1
end_data
