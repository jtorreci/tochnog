( F4 T4 / K20: two axisymmetric quad4 p-refined to quad9 [no longer
  refused], radial edge force 1000 on the outer radius r = 1, E 1, nu 0:
  uniform sigxx = sigzz = 1000 and u_r = 1000 r. 3x3 Gauss as the
  Professional 02-08-2026: post_point [0.5, 0.5] sigxx 1000, sigzz 1000
  [Professional 1000 / 1000], disx 500 [analytic; Professional
  499.9988]. Old GNU: "Error, not available for axisymmetric analysis". )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia

node 1  0.0 0.0
node 2  0.7 0.0
node 3  0.0 1.0
node 4  0.5 1.0
node 5  1.0 0.0
node 6  1.0 1.0

element 1  -quad4 1 2 3 4
element 2  -quad4 2 4 5 6

group_type 0  -materi
group_axisymmetric 0 -yes
group_materi_elasti_young 0  1.0
group_materi_memory 0  -total_linear

start_define
  inner_radius geometry_line  1
end_define
inner_radius  0. 0. 0. 1. 1.e-4

start_define
  lower_edge geometry_line  2
end_define
lower_edge  0. 0. 1. 0. 1.e-4

start_define
  upper_edge geometry_line  3
end_define
upper_edge  0. 1. 1. 1. 1.e-4

start_define
  outer_radius  geometry_line  4
end_define
outer_radius  1. 0. 1. 1. 1.e-4

bounda_dof     1  -inner_radius -velx 
bounda_time    1  0. 0. 100. 0.
bounda_dof     2  -lower_edge -vely 
bounda_time    2  0. 0. 100. 0.

force_edge 0  1000. 0.
force_edge_geometry 0  -outer_radius

post_point 1  0.5 0.5


control_mesh_refine_globally 10  -p_refinement

control_timestep             20  1. 1.
target_item 1  -post_point_dof 1 -sigxx
target_value 1  1000.0 1.e-6
target_item 2  -post_point_dof 1 -sigzz
target_value 2  1000.0 1.e-6
target_item 3  -post_point_dof 1 -disx
target_value 3  500.0 1.e-3
end_data
