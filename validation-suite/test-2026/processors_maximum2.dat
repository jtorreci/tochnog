(
F5 W1 U2: processors_maximum -yes: every CPU of the affinity mask;
build_safe checks options_processors in the .dbs against nproc (capped
at MTHREAD 64).
Same unit quad4 bar as force_point_sign1 (disx 2).
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1
group_materi_elasti_poisson 0 0
group_materi_memory 0 -total_linear
bounda_dof 0 1 -velx
bounda_dof 1 3 -velx
bounda_dof 2 1 -vely
bounda_dof 3 2 -vely
bounda_time 0 0 0 1 0
bounda_time 1 0 0 1 0
bounda_time 2 0 0 1 0
bounda_time 3 0 0 1 0
force_point 0 1.0 0.5 2.0 0.0
processors_maximum -yes
control_timestep 0 1 1
target_item    1  -node_dof 2 -disx
target_value   1  2.0 1.e-6
target_item    2  -node_dof 4 -disx
target_value   2  2.0 1.e-6
end_data
