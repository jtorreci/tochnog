( _element_group_truss 1 2 with _element_group_isoparametric 5 0
  [6.248/6.249]: the first truss group goes with the first isoparametric
  group. Truss 1 is tied only where it lies in group 5 [node 11], truss 2
  only in group 0 [node 12]. The Professional 02-08-2026 ignores the
  isoparametric restriction and ties all four nodes [class D
  TRUSS-DISTRIBUTE-ISO-SELECTION, the GNU follows the manual].
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 10 0
node 3 20 0
node 4 0 10
node 5 10 10
node 6 20 10
node 7 0 20
node 8 10 20
node 9 20 20
element 1 -quad4 1 2 4 5
element_group 1 0
element 2 -quad4 2 3 5 6
element_group 2 5
element 3 -quad4 4 5 7 8
element_group 3 0
element 4 -quad4 5 6 8 9
element_group 4 5
node 10 2 3
node 11 17 11
element 5 -truss 10 11
element_group 5 1
node 12 3 12
node 13 18 18
element 6 -truss 12 13
element_group 6 2
group_type 1 -truss
group_truss_area 1 0.1
group_truss_memory 1 -total_linear
group_truss_elasti_young 1 1.
group_type 2 -truss
group_truss_area 2 0.1
group_truss_memory 2 -total_linear
group_truss_elasti_young 2 1.
control_mesh_truss_distribute_mpc 10 -yes
control_mesh_truss_distribute_mpc_element_group_truss 10 1 2
control_mesh_truss_distribute_mpc_element_group_isoparametric 10 5 0
end_data
