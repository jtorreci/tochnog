( F4 T8 C46b: control_mesh_move on the SAME index as a two-step
  control_timestep [move x by 10]. Manual 6.217: the mesh is moved. The
  GNU moves node and node_start_refined once per control index: node 6
  at 12 1. Old GNU: moved on every step [22 1]. The Professional
  02-08-2026 moved only node_start_refined [12 1, once] and left the
  node at 2 1 [Professional-suspect, DIVERGENCES C46b]. build_safe.sh
  checks the .dbs. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_stress
end_initia
geometry_brick 1  0. 0. 0. 400. 400. 400. 1.e-4
bounda_dof 1 -geometry_brick 1 -velx -vely
group_type 0  -materi
group_materi_elasti_young   0  1.0e6
group_materi_elasti_poisson 0  0.2
group_materi_density   0  1.0
control_mesh_macro 0   -rectangle 0 3 2
control_mesh_macro_parameters 0   1. 0.5 2. 1.
control_timestep 0 0.1 0.1
control_mesh_move 1 10. 0. 0. 0. 0. 0.
control_timestep 1 0.1 0.2
end_data
