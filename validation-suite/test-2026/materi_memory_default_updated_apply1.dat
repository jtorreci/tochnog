( C16: control_materi_updated_apply -yes with NO group_materi_memory
  record. Single quad4, simple shear gamma = 1 with velocity kinematics -
  materi_velocity_integrated -, young 1, poisson 0. GNU follows manual
  Professional 6.152: -yes sets any non-specified memory to -updated for
  the timesteps with the same index, giving the -updated values
  sigxx 0.231098, sigxy 0.420739, sigyy -0.228598, identical to an
  explicit group_materi_memory -updated in both GNU and Professional.
  DOCUMENTED DIVERGENCE: the Professional 02-08-2026 binary ignores -yes
  for a non-specified memory and gives sigxx 0, sigxy 0.5, sigyy 0. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_stress
end_initia
node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
element 1  -quad4 1 2 3 4
group_type 0  -materi
group_materi_elasti_young 0  1.0
group_materi_elasti_poisson 0  0.0
bounda_dof 0  -ra 1 2 -ra -velx
bounda_dof 1  -ra 3 4 -ra -velx
bounda_dof 2  -ra 1 2 3 4 -ra -vely
bounda_time 1  0. 1. 1. 1.
control_materi_updated_apply 0  -yes
control_timestep 0  0.01 1.
control_timestep_iterations 0  20
target_item 0  -node_dof 4 -sigxx
target_value 0  0.231098 1.e-5
target_item 1  -node_dof 4 -sigxy
target_value 1  0.420739 1.e-5
target_item 2  -node_dof 4 -sigyy
target_value 2  -0.228598 1.e-5
target_item 3  -node_dof 3 -sigxy
target_value 3  0.420739 1.e-5
end_data
