( F3/C20: same simple shear gamma = 0.5 as
  materi_memory_updated_jaumann_shear1 but in 100 steps: sigxx
  0.0618335, sigxy 0.2396333, sigyy -0.0618335 (Professional 02-08-2026
  0.06183352822 / 0.2396333009 / -0.06183352822, identical to the GNU). )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1.0
group_materi_elasti_poisson 0 0.0
group_materi_memory 0 -updated_jaumann
mesh -fixed_in_space -fixed_in_space
bounda_dof 0 -ra 1 2 -ra -velx
bounda_dof 1 -ra 3 4 -ra -velx
bounda_dof 2 -ra 1 2 3 4 -ra -vely
bounda_time 1 0. 0.5 1. 0.5
control_timestep 0 0.01 1.
control_timestep_iterations 0 20
target_item 0  -node_dof 4 -sigxx
target_value 0  0.0618335 1e-06
target_item 1  -node_dof 4 -sigxy
target_value 1  0.2396333 1e-06
target_item 2  -node_dof 4 -sigyy
target_value 2  -0.0618335 1e-06
end_data
