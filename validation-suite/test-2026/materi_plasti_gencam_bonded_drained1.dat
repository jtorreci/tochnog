(Bonded-soil generalised Cam clay (group_materi_plasti_generalised_non_associate_cam_clay_for_bonded_soils). Drained triaxial
 compression of the element of gencam_bonded_iso1 from an isotropic 140 with a constant cell pressure 140
 (force_edge_normal on the outer edge): the radial stress stays -140, the stress path has dq/dp = 3, and
 with monotonic compaction p_s = 100 exp(10 eps_v^p) and p_m = 50 exp(-5 eps_v^p) hold exactly
 (eps_v^p = 0.1054813073 at eps_yy = -0.15: p_s = 287.143835, p_m = 29.506674). The final state lies on
 the yield surface (independent quadrature: f/p_c = -1.9e-9).)

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_strain_plasti
materi_strain_plasti_generalised_non_associate_cam_clay_for_bonded_soils
materi_stress
materi_plasti_generalised_non_associate_cam_clay_for_bonded_soils_history
end_initia

node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1

element 1  -quad4 1 2 3 4

start_define
  left_edge  geometry_line 0
end_define
start_define
  lower_edge geometry_line 1
end_define
start_define
  upper_edge geometry_line 2
end_define
start_define
  right_edge geometry_line 3
end_define

left_edge  0. 0. 0. 1.  1.e-5
lower_edge 0. 0. 1. 0.  1.e-5
upper_edge 0. 1. 1. 1.  1.e-5
right_edge 1. 0. 1. 1.  1.e-5

bounda_dof     0  -left_edge  -velx
bounda_time    0  0. 0. 100. 0.
bounda_dof     1  -lower_edge -vely
bounda_time    1  0. 0. 100. 0.
bounda_dof     2  -upper_edge -vely
bounda_time    2  0. -1. 100. -1.

group_type                     0  -materi
group_materi_memory            0  -total_linear
group_materi_elasti_young      0  10000.
group_materi_elasti_poisson    0  0.25
group_materi_plasti_generalised_non_associate_cam_clay_for_bonded_soils 0
  0.9 0.4 1.1  0.9 0.4 1.2  10. 0.  5. 0.  0.1
group_axisymmetric             0 -yes
force_edge_normal_geometry     0  -right_edge
force_edge_normal              0  -140.

post_point 1  0.5 0.5

control_reset_dof                1 -sigxx -sigyy -sigzz
control_reset_value_constant     1 -140.
control_reset_dof                2 -gencamhis0
control_reset_value_constant     2 100.
control_reset_dof                3 -gencamhis1
control_reset_value_constant     3 50.

control_timestep                20   0.00005 0.15

target_item    0  -post_point_dof 1 -sigxx
target_value   0  -140. 1.e-5
target_item    1  -post_point_dof 1 -sigyy
target_value   1  -311.451280634 1.e-3
target_item    2  -post_point_dof 1 -gencamhis0
target_value   2  287.143835434 1.e-3
target_item    3  -post_point_dof 1 -gencamhis1
target_value   3  29.5066738196 1.e-4
end_data
