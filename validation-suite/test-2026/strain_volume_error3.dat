( strain_volume_* with group_materi_memory -updated {large deformation, no
  materi_displacement}: input error, as strain_volume_error2. The
  Professional 02-08-2026 runs and gives absolute 0.
  EXPECTED_ERROR: Error: strain_volume needs a small deformation memory
)
echo -no
number_of_space_dimensions 3
materi_velocity
materi_stress
end_initia
node 1 0 0 0
node 2 2 0 0
node 3 0 2 0
node 4 2 2 0
node 5 0 0 1
node 6 2 0 1
node 7 0 2 1
node 8 2 2 1
node 9 0 0 3
node 10 2 0 3
node 11 0 2 3
node 12 2 2 3
element 1 -hex8 1 2 3 4 5 6 7 8
element 2 -hex8 5 6 7 8 9 10 11 12
group_type 0 -materi
group_materi_elasti_young 0 1.0e6
group_materi_elasti_poisson 0 0.2
group_materi_memory 0 -updated
bounda_dof 10 -ra 1 3 5 7 9 11 -ra -velx
bounda_dof 20 -ra 1 2 5 6 9 10 -ra -vely
bounda_dof 30 -ra 1 2 3 4 -ra -velz
strain_volume_absolute_time 10 0. 0. 1. 0.6
control_timestep 10 1. 1.
end_data
