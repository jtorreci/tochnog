(F4 T6f WU1, nodal recovery of the tet4 [1-point rule]. Two tet4 of volume
 1/6 and 5/6 and different stiffness share the face 2-3-4. Professional
 02-08-2026: node = arithmetic mean of the adjacent elements' values [GNU
 before the fix volume-weighted]. Targets = Professional.)
echo -no
number_of_space_dimensions 3
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia
node 1 0 0 0
node 2 1 0 0
node 3 0 1 0
node 4 0 0 1
node 5 2 2 2
element 1 -tet4 1 2 3 4
element 2 -tet4 2 3 4 5
element_group 1 0
element_group 2 1
bounda_dof 0 1 -velx -vely -velz
bounda_time 0 0. 0. 1.e10 0.
bounda_dof 1 2 -vely -velz
bounda_time 1 0. 0. 1.e10 0.
bounda_dof 2 3 -velz
bounda_time 2 0. 0. 1.e10 0.
bounda_dof 3 5 -velx
bounda_time 3 0. 1.e-3 1.e10 1.e-3
bounda_dof 4 5 -vely
bounda_time 4 0. 5.e-4 1.e10 5.e-4
bounda_dof 5 5 -velz
bounda_time 5 0. -2.e-4 1.e10 -2.e-4
group_type 0 -materi
group_materi_elasti_young 0 1.e4
group_materi_elasti_poisson 0 0.2
group_type 1 -materi
group_materi_elasti_young 1 3.e4
group_materi_elasti_poisson 1 0.3
control_timestep 10 1. 1.
target_item 0 -node_dof 2 -sigxx
