group_materi_plasti_tension_direct 1  1.e10
group_materi_plasti_tension_direct_normal_automatic 1  -yes

group_type 2  -materi
group_materi_elasti_young 2  1.0

bounda_dof  0  -ra 1 4 -ra -velx -vely

control_timestep 0  1. 1.

