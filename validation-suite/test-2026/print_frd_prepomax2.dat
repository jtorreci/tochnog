(F5 W2 V2: print_frd_prepomax -yes on two tria3: penta6 frd type 2 with
 nodes 1 2 3 6 7 8 and 2 4 3 7 9 8, = Professional 02-08-2026.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
