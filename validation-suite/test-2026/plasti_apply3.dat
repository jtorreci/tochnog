(plasti_apply -no on the Professional test validation/validation_13.dat, Cam clay:
 the preconsolidation history does not evolve. Pro 02-08-2026: cchis1 207; active 262.32)
(Validation 13, see manual.
 Element test: undrained (constant volume) triaxial compression, strain control,
 elasto-plasticity: Modified Cam Clay,
 parameters of Weald clay after Carter, 1982.
 Test supplied by herle@linux.itam.cas.cz )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_strain_plasti
materi_stress
materi_plasti_camclay_history
end_initia

node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1

element 1  -quad4 1 2 3 4

start_define
  left_edge  geometry_line 0
end_define
start_define
  lower_edge geometry_line 1
end_define
start_define
  upper_edge geometry_line 2
end_define
start_define
  right_edge geometry_line 3
end_define

left_edge  0. 0. 0. 1.  1.e-5
lower_edge 0. 0. 1. 0.  1.e-5
upper_edge 0. 1. 1. 1.  1.e-5
right_edge 1. 0. 1. 1.  1.e-5

bounda_dof     0  -left_edge  -velx
bounda_time    0  0. 0. 100. 0.
bounda_dof     1  -lower_edge -vely
bounda_time    1  0. 0. 100. 0.
bounda_dof     2  -upper_edge -vely
bounda_time    2  0. -1. 100. -1.
bounda_dof     3  -right_edge  -velx
bounda_time    3  0. 0.5 100. 0.5

group_type                     0  -materi
group_materi_memory            0  -total_linear
group_materi_plasti_camclay    0  0.882  0.031  0.088
group_materi_elasti_camclay_g  0  3000.
group_materi_elasti_camclay_pressure_min  0  1.
group_axisymmetric             0 -yes

post_point 1  0.5 0.5

control_reset_dof                1 -sigxx -sigyy -sigzz
control_reset_value_constant     1 -207.
control_reset_dof                2 -cchis0
control_reset_value_constant     2 0.627
control_reset_dof                3 -cchis1
control_reset_value_constant     3 207.0

control_timestep                20   0.001 0.12
(
control_print                   20  -time_current
control_print_data_versus_data  20  -post_point_dof 1 -eptxx
                                    -post_point_dof 1 -eptyy
                                    -post_point_dof 1 -sigxx
                                    -post_point_dof 1 -sigyy
                                    -post_point_dof 1 -cchis0
                                    -post_point_dof 1 -cchis1
)

plasti_apply -no
target_item    0  -post_point_dof 1 -cchis1
target_value   0  207. 1.e-3
end_data
