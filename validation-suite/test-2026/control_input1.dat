(
F5 W1 U6: control_input index -yes (manual Professional 6.139): at the start
 of control index 1 the records of the file 1.dat are read (build_safe.sh
 runs this test in an isolated directory with 1.dat =
 "group_materi_elasti_young 0 2000 end_data"). One quad4, poisson 0,
 -updated_linear, two steps of -0.01: step 1 with E 1000 (-10), step 2 with
 the replaced E 2000 (-20 more): sigyy -30 without the file read, -50 with it
 (= Professional 02-08-2026; control_input 0 gives -60).)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_strain_total
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1000
group_materi_elasti_poisson 0 0.
group_materi_memory 0 -updated_linear
bounda_dof 0 -ra 1 2 -ra -vely
bounda_dof 1 -ra 1 3 -ra -velx
bounda_dof 2 -ra 3 4 -ra -vely
bounda_time 2 0 0 2 -0.02
control_timestep 0 1 1
control_timestep 2 1 1
control_input 1 -yes
target_item 0 -node_dof 4 -sigyy
target_value 0 -50. 1.e-8
end_data
