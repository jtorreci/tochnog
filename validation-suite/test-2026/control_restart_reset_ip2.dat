(F4 T6c, control_restart resets the integration-point state, elastic.
 Same model as control_restart_reset_ip1 without plasticity: 10 steps to
 t 1, restart, 5 steps to t 0.5. Targets at node 4 = Professional
 02-08-2026 (= the analytic fresh 0.5 run). Before the fix the GNU kept
 the old IP strain/stress: sigyy +52.08, eptyy +5e-3 (sign flipped).)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_strain_plasti
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
geometry_line 0 0 0 0 1 1.e-5
geometry_line 1 0 0 1 0 1.e-5
geometry_line 2 0 1 1 1 1.e-5
bounda_dof 0 -geometry_line 0 -velx
bounda_time 0 0. 0. 1.e10 0.
bounda_dof 1 -geometry_line 1 -vely
bounda_time 1 0. 0. 1.e10 0.
bounda_dof 2 -geometry_line 2 -vely
bounda_time 2 0. -1.e-2 1.e10 -1.e-2
group_type 0 -materi
group_materi_elasti_young 0 1.e4
group_materi_elasti_poisson 0 0.2
group_materi_memory 0 -total_linear
control_timestep 10 0.1 1.0
control_restart 20 -yes
control_timestep 30 0.1 0.5
target_item 0 -node_dof 4 -sigyy
target_value 0 -5.208333333333e+01 1.e-6
target_item 1 -node_dof 4 -sigzz
target_value 1 -1.041666666667e+01 1.e-6
target_item 2 -node_dof 4 -eptyy
target_value 2 -5.0e-03 1.e-10
target_item 3 -node_dof 4 -disx
target_value 3 1.25e-03 1.e-10
end_data
