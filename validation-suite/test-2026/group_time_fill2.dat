( group_time_fill (manual 6.770), F5 T5 U7: as group_time_fill1 with a
  Mohr-Coulomb upper element (phi 0.1, c 0.01) and nu 0.3. While it is being
  filled the plasticity is ignored: at t = 2 (factor 0.75) the response is
  elastic. Professional 02-08-2026: disy -1.028571428571e-02 at y = 2.
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
node 5 0 2
node 6 1 2
element 1 -quad4 1 2 3 4
element 2 -quad4 3 4 5 6
element_group 2 1
group_type 0 -materi
group_materi_elasti_young 0 1000
group_materi_elasti_poisson 0 0
group_materi_memory 0 -total_linear
group_materi_density 0 1
group_type 1 -materi
group_materi_elasti_young 1 1000
group_materi_elasti_poisson 1 0.3
group_materi_memory 1 -total_linear
group_materi_plasti_mohr_coul 1 0.1 0.01 0.
group_materi_density 1 1
group_time_fill 1 0.5 2.5 100
force_gravity 0 -10
bounda_dof 0 -ra 1 2 -ra -velx -vely
bounda_dof 1 -ra 3 4 5 6 -ra -velx
control_timestep 10 0.25 0.5
control_timestep 20 0.25 0.5
control_timestep 30 0.25 0.5
control_timestep 40 0.25 0.5
target_item    1  -node_dof 5 -disy
target_value   1  -1.028571428571e-02 1.e-10
end_data
