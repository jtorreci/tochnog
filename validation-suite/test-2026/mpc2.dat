( Copy of the Professional 02-08-2026 example test/other/mpc2.dat
  [mpc_geometry 6.866, default -method0]: nodes 2 and 4 of the right edge
  are tied to nodes 1 and 3; targets and mpc records = Professional. )
( 
Test multi point constraint in 2D.
Geometry_line 20 (right edge) is constrained to geometry_line 10 (left edge).
Nodes 1,3 are located in geometry_line 10.
Nodes 2,4 are located in geometry_line 20.
Nodes 1,3 are prescribed a x-displacement 1.
So nodes 2,4 also get a x-displacement 1.
)

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia

geometry_line 10  0. 0. 0. 1. 1.e-6
geometry_line 20  1. 0. 1. 1. 1.e-6

node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
element 1  -quad4 1 2 3 4

group_type 0  -materi
group_materi_memory 0  -total_linear
group_materi_elasti_young 0  1.0

bounda_dof   10  -geometry_line 10 -vely
bounda_time  10  0. 0. 100. 0.
bounda_dof   20  -geometry_line 10 -velx
bounda_time  20  1.

mpc_geometry 10 -geometry_line 10 -geometry_line 20
mpc_geometry_dof 10 -velx -vely
mpc_geometry_switch 10 -no -yes

control_timestep 0  1. 1.
(
control_print    0  -time_current -node_dof
)

target_item  0   -node_dof 2 -disx
target_value 0   1.0 1.e-4
target_item  1   -node_dof 4 -disx
target_value 1   1.0 1.e-4
end_data
