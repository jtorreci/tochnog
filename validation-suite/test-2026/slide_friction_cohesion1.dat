( F4 T6e C53 (2026-10-11): slide_plasti_friction cap and tension
  default. slide4 variant with cohesion (slide_plasti_friction 10
  0.523598 0.002) and end time 10. The top is pressed down (vely
  -0.01) and then dragged at velx 1 over the bottom slide plane.
  An absent slide_plasti_tension means NO tension limit (the normal
  spring is two-sided) and the friction cap is c + |Fn|*tan(phi):
  node 1 (x=0) keeps a small normal force Fn = 1.134e-4 (node_slide_force
  slot 0 -1.134e-4) and slides at the cap 0.002 + 0.57735*1.134e-4,
  node_slide_force 1 slot 1 = -2.065482e-3 (Professional 02-08-2026
  -2.065482222595e-3). GNU before the fix (tension cap sig_t default 0,
  cap c + Fn*tan(phi) clamped at 0): node 1 lifts off (slot 0 = 0) and
  slides at the bare cohesion -0.002.
)

echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_stress
end_initia

start_define
  bottom geometry_line 1
end_define
bottom 0. 0. 1. 0. 1.e-4

start_define
  top geometry_line 2
end_define
top 0. 1. 1. 1. 1.e-4

node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
element 1  -quad4 1 2 3 4

group_type 0  -materi
group_materi_elasti_young 0  1.0

bounda_dof     0  -top -vely
bounda_time    0  0. -1.e-2 1. -1.e-2 1.00001 0.0 1.e10 0.0
bounda_dof     1  -top -velx
bounda_time    1  1.00001 1. 1.e10 1.

slide_geometry 10  -bottom
slide_plasti_friction 10  0.523598 0.002
slide_stiffness 10  1.e3 1.e3

post_node 10  -node_rhside -sum -top
print_filter 10  -node_dof -all -velx -vely -velix -veliy

control_timestep 0  1.e-2 10.
target_item  0  -node_slide_force 1 1
target_value 0  -2.065482e-3 1.e-8

end_data
