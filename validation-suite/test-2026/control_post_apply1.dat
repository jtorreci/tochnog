(F5 W1 U3: control_post_apply 1 -no, manual Pro 6.259: the post records
 are not evaluated in the timesteps of index 1; the post_point_dof history
 (build_safe check on disy0.his) stays at 0.0015 from t = 0.6 to 1. The
 Professional 02-08-2026 evaluates the post records once more at the end
 of the run: the final post_point_dof disy is 0.0055 (target). Quad4,
 top vely ramp, two control indices of 5 steps.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_memory 0 -total_linear
group_materi_elasti_young 0 1000.
group_materi_elasti_poisson 0 0.3
geometry_line 1 0 0 1 0 0.01
geometry_line 2 0 0 0 1 0.01
geometry_line 3 0 1 1 1 0.01
bounda_dof 0 -geometry_line 1 -vely
bounda_dof 1 -geometry_line 2 -velx
bounda_dof 2 -geometry_line 3 -vely
bounda_time 2 0 0 1 0.02
post_point 0 0.5 0.5
post_element_force 0 0. 1. 0. 0. 0.5 0.
post_element_force_geometry 0 -geometry_line 1
control_timestep 0 0.1 0.5
control_timestep 1 0.1 0.5
control_post_apply 1 -no
control_print_history 0 -post_point_dof 0 -disy
control_print_history 1 -post_point_dof 0 -disy
target_item 0 -post_point_dof 0 -disy
target_value 0 0.0055 1.e-9
target_item 1 -node_dof 4 -disy
target_value 1 0.011 1.e-9
end_data
