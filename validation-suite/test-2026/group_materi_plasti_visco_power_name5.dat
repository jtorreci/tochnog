(F5 T3 D2: materi_plasti_visco_apply -no also switches off the named
 visco data {Professional 02-08-2026 sigxx 1, eppxx 1}.)
echo -no
number_of_space_dimensions 1
materi_velocity
materi_displacement
materi_strain_total
materi_strain_plasti
materi_stress
end_initia
node 1  0
node 2  1
element 1  -bar2 1 2
bounda_dof 0  1 -velx
bounda_time 0  0.
bounda_dof 1  2 -velx
bounda_time 1  1.
group_type 0  -materi
group_materi_elasti_young 0  2.0
group_materi_memory 0  -total_linear
group_materi_plasti_tension 0  1.
control_timestep 0  0.5 0.5
control_timestep 1  1. 1.
group_materi_plasti_visco_power_name 0 -group_materi_plasti_tension
group_materi_plasti_visco_power_value 0 1.e-1 1.
materi_plasti_visco_apply -no
target_item 0 -node_dof 1 -sigxx
target_value 0 1. 1.e-6
end_data
