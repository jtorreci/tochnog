( Copy of the Professional 02-08-2026 example test/other/truss12.dat: the
  truss on the tria3 edge is recreated as element 3 without mpc's [both
  nodes are tria3 nodes], as the Professional; targets = Professional. )
( Truss in total lagrange Solid.
  Two-dimensional.
  Truss force 1.
  Since the truss area is 1, this truss force should lead to forces 1 on node 4 and 5 in x direction)

echo -no
number_of_space_dimensions 2
materi_velocity
materi_stress
materi_displacement
materi_strain_total
end_initia

node 1  0 0
node 2  1 0
node 3  0 1
element 1 -tria3 1 2 3
element 2 -truss 1 3
element_group 2 1

group_type 0  -materi
group_materi_memory 0  -total

group_type 1  -truss
group_truss_area 1  1.
group_truss_memory 1  -total_linear
group_truss_elasti_young 1  1.
group_truss_initial_force 1  1.

bounda_dof   0  -all -velx -vely
bounda_time  0  0.0 0.0 100. 0.

print_filter 0 -node_rhside -all -velx -vely

control_mesh_truss_distribute_mpc 10  -yes
control_mesh_truss_distribute_mpc_element_group_truss 10  1

control_timestep 20  1. 1. 
(control_print    20  -node_rhside)

target_item 1  -node_rhside 1 -vely
target_value 1  +1. 1.e-5
target_item 2  -node_rhside 3 -vely
target_value 2  -1. 1.e-5
end_data
