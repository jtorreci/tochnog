( control_mesh_truss_distribute_mpc_exact [manual Professional 6.250], 1D.
  Truss 2..18 over the bars 0-10 and 10-20: split where it enters the
  second bar [new node 6 at x=10], both pieces tied with mpc's.
  Professional 02-08-2026: the same pieces and factors, node 7 / elements
  4 and 6 [the GNU numbers the new nodes and elements compactly, class C
  TRUSS-DISTRIBUTE-NUMBERING]. Checked by elem_check / mpc_check.
)
echo -no
number_of_space_dimensions 1
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0
node 2 10
node 3 20
element 1 -bar2 1 2
element 2 -bar2 2 3
node 4 2
node 5 18
element 3 -truss 4 5
element_group 3 1
group_type 1 -truss
group_truss_area 1 0.1
group_truss_memory 1 -total_linear
group_truss_elasti_young 1 1.
control_mesh_truss_distribute_mpc 10 -yes
control_mesh_truss_distribute_mpc_exact 10 -yes
end_data
