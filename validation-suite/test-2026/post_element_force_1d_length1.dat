( LOW queue Q1 {F4 T6f, 2026-10-17}: post_element_force in 1D writes a
  ONE-value result, the normal force {Professional 02-08-2026 force16:
  post_element_force_result 10 5.034285714286, a single value}. Input =
  the Professional test/other/force16.dat {two bar2 groups tied by
  mpc_element_group, inertia and gravity active, section at x=1}.
  Target: the Professional value, tolerance 4e-6 of max{|value|,1}.
  The companion post_element_force_1d_length_error1 checks that no
  second value exists {before Q1 the GNU wrote five values, 4 zeros}. )
echo -no
number_of_space_dimensions 1
materi_velocity
materi_displacement
materi_stress
end_initia

node 1  0
node 2  1
node 3  1
node 4  2
element 1  -bar2 1 2
element 2  -bar2 3 4

element_group 1 1
element_group 2 2

group_type 1  -materi
group_materi_memory 1  -total_linear
group_materi_density 1  1.0
group_materi_elasti_young 1  1.0

group_type 2  -materi
group_materi_memory 2  -total_linear
group_materi_density 2  1.0
group_materi_elasti_young 2  1.0

bounda_dof   10  -ra 1 -ra  -velx
bounda_time  10  1.

mpc_element_group 10  2 1

inertia_apply -yes

force_gravity 9.81

geometry_point 10  1. 1.e-4
post_element_force 10  1. 1.
post_element_force_geometry 10  -geometry_point 10
post_element_force_group 10  1

control_timestep 10  1. 1.

target_item    0  -post_element_force_result 10 0
target_value   0  5.034285714286 2.0e-05
end_data
