( F5 T4 U9e owner decision 2026-11-11: a reactivated element starts its
  integration point stresses from the nodal values set on reactivation
  (free nodes 7 8: factor 0.5 times the mean of the active nodes 4 5),
  interpolated with the shape functions. All nodes are bounded; nodes 4 5
  move only in stage 10 (bounda_time), so the reactivation step at 20 adds
  no increment and element_intpnt_dof shows the start. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0. 0.
node 2 1. 0.
node 4 0. 1.
node 5 1. 1.
node 7 0. 2.
node 8 1. 2.
element 1 -quad4 1 2 4 5
element 2 -quad4 4 5 7 8
element 3 -quad4 4 5 7 8
element_group 2 2
element_group 3 1
group_type -ra 0 1 2 -ra -materi
group_materi_elasti_young -ra 0 1 2 -ra 1000.
group_materi_elasti_poisson -ra 0 1 2 -ra 0.2
bounda_dof 1 -ra 1 2 7 8 -ra -velx -vely
bounda_dof 2 -ra 4 5 -ra -velx
bounda_dof 3 -ra 4 5 -ra -vely
bounda_time 3 0. -0.01 1. -0.01 1.0001 0. 100. 0.
control_mesh_remove 10 -method1 2 1
control_mesh_remove_really 10 -no
control_timestep 10 1. 1.
control_print_database 10 -yes
control_mesh_delete_element 15 3
control_timestep 15 1. 1.
control_print_database 15 -yes
control_mesh_remove 20 -method1 7 8
control_mesh_remove_really_activate_factor 20 0.5
control_timestep 20 1. 1.
control_print_database 20 -yes
end_data
