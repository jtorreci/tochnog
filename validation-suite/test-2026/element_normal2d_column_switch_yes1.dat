( element_normal with group_materi_plasti_tension_direct_normal_automatic
  switched -yes: companion of element_normal2d_column_switch_no1.
  Same 2D column of two quad4 stretched in x. The upper element uses
  its element_normal (0,-1) as the cut-off plane normal; the normal
  stress on that plane (sigyy) stays 0, so the cut-off does not limit
  sigxx: sigxx 1 in both elements (nodes 1, 3, 5, 6).
  Pro 02-08-2026 gives exactly these values. )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
node 5  0 2
node 6  1 2
element 1  -quad4 1 2 3 4
element 2  -quad4 3 4 5 6

element_group 1 1
element_group 2 2

group_type 1  -materi
group_materi_elasti_young 1  1.0

group_type 2  -materi
group_materi_elasti_young 2  1.0
group_materi_plasti_tension_direct 2  0.0
group_materi_plasti_tension_direct_normal_automatic 2  -yes

bounda_dof  0  -ra 1 3 5 -ra -velx
bounda_dof  1  1 -vely
bounda_dof  2  -ra 2 4 6 -ra -velx
bounda_time 2  1.

control_timestep 0  1. 1.
control_timestep_iterations 0 5

target_item    0  -element_normal 2 1
target_value   0  -1. 1.e-10
target_item    1  -node_dof 1 -sigxx
target_value   1  1. 1.e-8
target_item    2  -node_dof 5 -sigxx
target_value   2  1. 1.e-8
target_item    3  -node_dof 6 -sigxx
target_value   3  1. 1.e-8
end_data
