( F5 T5 U3b: groundflow_phreatic_project -no (manual 6.582), the default:
  the same results as groundflow_phreatic_inclined1 (no record).
  The nodes at and above the level get the head of the level above them,
  rho*g*z_L(x), so water seeps through the column (no pressure records).
  GNU pressure dof = head - rho*g*z_ref, z_ref = first level height (1).
  The total pressures equal the Professional 02-08-2026 for the same input.
)
echo -no
number_of_space_dimensions 2
groundflow_pressure
groundflow_velocity
end_initia
node 1  0 0
node 2  1 0
node 3  2 0
node 4  0 1
node 5  1 1
node 6  2 1
node 7  0 2
node 8  1 2
node 9  2 2
node 10 0 3
node 11 1 3
node 12 2 3
element 1  -quad4 1 2 4 5
element 2  -quad4 2 3 5 6
element 3  -quad4 4 5 7 8
element 4  -quad4 5 6 8 9
element 5  -quad4 7 8 10 11
element 6  -quad4 8 9 11 12
element_group 1 1
element_group 2 1
element_group 3 1
element_group 4 1
element_group 5 1
element_group 6 1
force_gravity 0. -1.
groundflow_density 1.
groundflow_phreatic_level 0. 1. 2. 2.5
groundflow_phreatic_project -no
post_calcul -groundflow_pressure -total_pressure
group_type 1  -groundflow
group_groundflow_permeability 1  0.1 0.1
control_timestep   10  1. 1.
target_item  0   -node_dof_calcul 1 0
target_value 0   -1.250606270570 1.e-6
target_item  1   -node_dof_calcul 3 0
target_value 1   -1.371687164386 1.e-6
target_item  2   -node_dof_calcul 5 0
target_value 2   -0.3571366707085 1.e-6
target_item  3   -node_dof_calcul 6 0
target_value 3   -0.4843235752642 1.e-6
target_item  4   -node_dof 8 0
target_value 4   -0.75 1.e-6
target_item  5   -node_dof 12 0
target_value 5   -1.5 1.e-6
end_data
