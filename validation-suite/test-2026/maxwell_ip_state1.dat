(C68, F4 T6f: the Maxwell stress is an integration-point state. Four tria3
 (1-point rule, nodal recovery = arithmetic mean, Professional) on a
 non-uniform field; HEAD read the h-lumped nodal value back.
 Targets = Professional 02-08-2026, scratch probe c68_maxwell3_tri.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
materi_strain_total
materi_maxwell_stress 1
end_initia
node 1 0 0
node 2 1 0
node 3 2 0
node 4 0 1
node 5 1 2
node 6 2 1
element 1 -tria3 1 2 4
element 2 -tria3 2 5 4
element 3 -tria3 2 3 5
element 4 -tria3 3 6 5
bounda_dof 0 1 -velx -vely
bounda_time 0 0. 0. 1.e10 0.
bounda_dof 1 2 -vely
bounda_time 1 0. 0. 1.e10 0.
bounda_dof 2 3 -vely
bounda_time 2 0. 0. 1.e10 0.
bounda_dof 3 4 -vely
bounda_time 3 0. -0.01 1.e10 -0.01
bounda_dof 4 5 -vely
bounda_time 4 0. -0.01 1.e10 -0.01
bounda_dof 5 6 -vely
bounda_time 5 0. -0.01 1.e10 -0.01
group_type 0 -materi
group_materi_elasti_young 0 7.e3
group_materi_elasti_poisson 0 0.
group_materi_memory 0 -total_linear
group_materi_maxwell_chain 0 7.e3 100.
control_timestep 10 0.1 1.
target_item 0 -node_dof 1 -1msigyy
target_value 0 -6.968599514197e+01 1.39e-01
target_item 1 -node_dof 2 -1msigyy
target_value 1 -4.645733009464e+01 9.29e-02
target_item 2 -node_dof 5 -1msigyy
target_value 2 -4.645733009464e+01 9.29e-02
end_data
