(
K04 ground9 (2026-10-06): group_interface_groundflow_permeability is
per unit length (manual Professional 6.628), so each facing node pair
of the interface carries its tributary length (Lobatto weight x side
length), as the mechanical interface springs. Pro test ground9 with the
mesh 3 wide: continuum element 0..1 (k = 0.1, conductance 0.1*3/1 = 0.3),
interface element 1..2 (pe = 0.1 per length, conductance 0.1*3 = 0.3),
pressure 1 at the bottom and 0 at the top: middle pressure 0.5 (=
Professional 02-08-2026). GNU before K04: 0.6 (pair conductance pe
without the length: 0.2), ground9 itself (width 1) 1/3.
)
echo -no
number_of_space_dimensions 2
groundflow_velocity
groundflow_pressure
end_initia

node 1  0 0
node 2  3 0
node 3  0 1
node 4  3 1
node 5  0 2
node 6  3 2

element 1  -quad4 1 2 3 4
element_group 1 0

element 2  -quad4 3 4 5 6 
element_group 2  1

bounda_dof 0  -ra 1 2 -ra -pres
bounda_time    0  0.0 0.0 1. 1. 100. 1.
bounda_dof 1  -ra 5 6 -ra -pres
bounda_time    1  0.0 0.0 100.0 0.

group_type 0  -groundflow
group_groundflow_permeability 0  0.1 0.1

group_type 1  -groundflow
group_interface 1  -yes
group_interface_groundflow_permeability 1  0.1

post_calcul -groundflow_pressure -total_pressure
print_filter 0  -node_dof -all -pres

control_timestep  0  1. 1.
(control_print     0  -time_current -node_dof)

target_item 0   -node_dof 3 -pres
target_value   0   0.5 1.e-6
target_item 1   -node_dof 4 -pres
target_value   1   0.5 1.e-6
end_data
