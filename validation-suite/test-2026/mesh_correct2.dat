number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
mesh_correct -yes
node 1 0. 0.
node 2 1. 0.
node 3 0. 1.
node 4 1. 1.
node 5 0. 1.
node 6 1. 1.
