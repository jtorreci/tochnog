(
F5 W1 U6: linear_calculation_apply -yes: group_materi_elasti_hardsoil is
 deleted and substituted by group_materi_elasti_young with E50ref as Young's
 modulus (manual Professional 6.797). E50ref 500, poisson 0 kept: sigyy
 -500 x 0.01 = -5 (= Professional 02-08-2026).)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
materi_plasti_hardsoil_history
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1000
group_materi_elasti_poisson 0 0.
bounda_dof 0 -ra 1 2 -ra -vely
bounda_dof 1 -ra 1 3 -ra -velx
bounda_dof 2 -ra 3 4 -ra -vely
bounda_time 2 0 0 1 -0.01
control_timestep 0 1 1
group_materi_elasti_hardsoil 0 500 1 0.2 0.5 1500 1 0.2
linear_calculation_apply -yes
target_item 0 -node_dof 4 -sigyy
target_value 0 -5. 1.e-8
end_data
