( element_normal, manual Professional 6.445: regenerated after a mesh
  change. 3x3 unit quad4 mesh; after the first control_timestep the
  bottom-middle element 2 is deleted. The mesh boundary then includes
  the sides of the hole: element 1 becomes (0.13677,0.99060) (node 2 now
  has the boundary sides bottom and right: (-1,1)/sqrt2), element 5 goes
  from interior (0,0) to (0,1), element 4 from (1,0) to
  (0.87736,0.47984). Values measured on Pro 02-08-2026. )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  0 0
node 2  1 0
node 3  2 0
node 4  3 0
node 5  0 1
node 6  1 1
node 7  2 1
node 8  3 1
node 9  0 2
node 10  1 2
node 11  2 2
node 12  3 2
node 13  0 3
node 14  1 3
node 15  2 3
node 16  3 3
element 1  -quad4 1 2 5 6
element 2  -quad4 2 3 6 7
element 3  -quad4 3 4 7 8
element 4  -quad4 5 6 9 10
element 5  -quad4 6 7 10 11
element 6  -quad4 7 8 11 12
element 7  -quad4 9 10 13 14
element 8  -quad4 10 11 14 15
element 9  -quad4 11 12 15 16

element_group 1 1
element_group 2 2
element_group 3 2
element_group 4 2
element_group 5 2
element_group 6 2
element_group 7 2
element_group 8 2
element_group 9 2

group_type 1  -materi
group_materi_elasti_young 1  1.0
group_materi_plasti_tension_direct 1  1.e10
group_materi_plasti_tension_direct_normal_automatic 1  -yes

group_type 2  -materi
group_materi_elasti_young 2  1.0

bounda_dof  0  -ra 1 4 -ra -velx -vely

control_timestep 0  1. 1.
control_mesh_delete_element 1  2
control_timestep 2  1. 1.

target_item    0  -element_normal 1 0
target_value   0  0.1367736396732 1.e-10
target_item    1  -element_normal 1 1
target_value   1  0.9906023276222 1.e-10
target_item    2  -element_normal 5 0
target_value   2  0.0 1.e-10
target_item    3  -element_normal 5 1
target_value   3  1.0 1.e-10
target_item    4  -element_normal 4 0
target_value   4  0.8773551979614 1.e-10
target_item    5  -element_normal 4 1
target_value   5  0.4798414911303 1.e-10
target_item    6  -element_normal 8 0
target_value   6  0.0 1.e-10
target_item    7  -element_normal 8 1
target_value   7  -1.0 1.e-10
end_data
