( Copy of the Professional 02-08-2026 example test/other/truss13.dat
  [_exact over an interface element]. Two changes: the second truss is
  element 6 here [Professional 8, class C TRUSS-DISTRIBUTE-NUMBERING], and
  control_timestep_iterations 20 50 is added: with the default 2 iterations
  the GNU mpc ties of this stiff truss converge too slowly [3.87 / 6.13,
  also with hand-written mpc records on the binary before F5 T4 U7,
  BACKLOG C128]; with 50 iterations both forces are 5 = Professional. )
( test distribution truss over an interface element )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1   0   0
node 2  10   0
node 3  10   0
node 4  20   0
node 5   0  10
node 6  10  10
node 7  10  10
node 8  20  10
node 9   5   5
node 10 15   5

( isoparametric )
element 1  -quad4 1 2 5 6
element 2  -quad4 3 4 7 8
element_group 1 0
element_group 2 0

( interface )
element 3  -quad4 2 6 3 7
element_group 3 1

( truss )
element 4  -truss 9 10
element_group 4  2

group_type 0  -materi
group_materi_memory 0  -total_linear
group_materi_elasti_young 0  1.

group_type 1  -materi
group_interface 1 -yes
group_interface_materi_memory 1  -total_linear
group_interface_materi_elasti_stiffness     1  0.10000E+11  0.50000E+10

group_type 2  -truss
group_truss_memory 2  -total_linear
group_truss_area 2  0.1
group_truss_elasti_young 2  1.e3

bounda_dof    10  -all -vely
bounda_dof    20  -ra 1 5 -ra -velx
bounda_dof    30  -ra 4 8 -ra -velx
bounda_time   30  1.e-1

control_mesh_truss_distribute_mpc 10 -yes
control_mesh_truss_distribute_mpc_exact 10 -yes

control_timestep 20  10. 10.
control_timestep_iterations 20 50

target_item  10 -element_truss_force 5 0
target_value 10 5. 1.e-2

target_item  20 -element_truss_force 6 0
target_value 20 5. 1.e-2
end_data
