( C84 {F4 T6f, 2026-10-17}: post_element_force {manual Professional
  6.927} in 2D with the 6-value record dir_normal_x dir_normal_y
  dir_shear0_x dir_shear0_y middle_x middle_y. A 4x1 strip of tria3 elements {each square split in two},
  fixed at x=0, loads velx 50 and vely 5 at the two x=4 corners;
  section at x=0 {normal 1 0, shear0 0 1, middle 0 0.5}. 2D result
  {Professional layout, three values}: normal 100, shear0 10, moment0
  -40, exact by equilibrium. Targets: the Professional 02-08-2026 on
  this file {tolerance 4e-6 of max{|value|,1}}. Before C84 the GNU
  skipped the 6-value record {it required 7 values} and with 7 values
  printed NaN or garbage. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 2 0
node 4 3 0
node 5 4 0
node 6 0 1
node 7 1 1
node 8 2 1
node 9 3 1
node 10 4 1
element 1 -tria3 1 2 7
element 2 -tria3 1 7 6
element 3 -tria3 2 3 8
element 4 -tria3 2 8 7
element 5 -tria3 3 4 9
element 6 -tria3 3 9 8
element 7 -tria3 4 5 10
element 8 -tria3 4 10 9
group_type 0 -materi
group_materi_elasti_young 0 1.e4
group_materi_elasti_poisson 0 0.
group_materi_memory 0 -total_linear
geometry_line 1 0. 0. 0. 1. 1.e-5
post_element_force 10 1. 0. 0. 1. 0. 0.5
post_element_force_geometry 10 -geometry_line 1
bounda_dof 20 1 -velx
bounda_time 20 0.
bounda_dof 21 1 -vely
bounda_time 21 0.
bounda_dof 22 6 -velx
bounda_time 22 0.
bounda_dof 23 6 -vely
bounda_time 23 0.
bounda_force 1 5 -velx
bounda_time 1 50.
bounda_force 2 5 -vely
bounda_time 2 5.
bounda_force 3 10 -velx
bounda_time 3 50.
bounda_force 4 10 -vely
bounda_time 4 5.
control_timestep 30 1. 1.

target_item 40 -post_element_force_result 10 0
target_value 40 100 4.0e-04
target_item 41 -post_element_force_result 10 1
target_value 41 10 4.0e-05
target_item 42 -post_element_force_result 10 2
target_value 42 -40 1.6e-04
end_data
