( C16 companion: default group_materi_memory on a -follow_material
  mesh. Single quad4 stretched uniaxially to twice its length with
  velocity kinematics in 100 steps, young 1, poisson 0, NO memory record.
  The default memory uses the current-geometry deformation gradient,
  giving sigxx = 0.695653; Professional 02-08-2026 gives the same value.
  The reference-configuration gradient that GNU uses for an EXPLICIT
  -updated_linear on -follow_material, sigxx = 1, must NOT be used for
  the default. Regression guard: GNU before C16 already gave 0.695653. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_stress
end_initia
node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
element 1  -quad4 1 2 3 4
group_type 0  -materi
group_materi_elasti_young 0  1.0
group_materi_elasti_poisson 0  0.0
mesh  -follow_material -follow_material
bounda_dof 0  -ra 1 3 -ra -velx
bounda_dof 1  -ra 2 4 -ra -velx
bounda_dof 2  -ra 1 2 -ra -vely
bounda_time 1  0. 1. 1. 1.
control_timestep 0  0.01 1.
control_timestep_iterations 0  20
target_item 0  -node_dof 4 -sigxx
target_value 0  0.695653 1.e-5
target_item 1  -node_dof 4 -sigyy
target_value 1  0. 1.e-6
end_data
