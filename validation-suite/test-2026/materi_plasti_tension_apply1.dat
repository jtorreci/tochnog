(F5 W1: materi_plasti_tension_apply -no, manual Pro 6.804: the
 tension_direct cut-off is ignored in every timestep, the quad4 stays
 elastic. Professional 02-08-2026: sigyy 21.978022, eppyy 0.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
materi_strain_plasti
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_memory 0 -total_linear
group_materi_elasti_young 0 1000.
group_materi_elasti_poisson 0 0.3
group_materi_plasti_tension_direct 0 1.
geometry_line 1 0 0 1 0 0.01
geometry_line 2 0 0 0 1 0.01
geometry_line 3 0 1 1 1 0.01
bounda_dof 0 -geometry_line 1 -vely
bounda_dof 1 -geometry_line 2 -velx
bounda_dof 2 -geometry_line 3 -vely
bounda_time 2 0 0.02 100 0.02
control_timestep 0 0.1 0.5
control_timestep 1 0.1 0.5
materi_plasti_tension_apply -no
target_item 0 -node_dof 4 -sigyy
target_value 0 21.978022 1.e-5
target_item 1 -node_dof 4 -eppyy
target_value 1 0. 1.e-10
end_data
