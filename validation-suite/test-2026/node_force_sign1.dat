(
C28 (2026-10-06): node_force is an external load along +force (manual
Professional 6.887), as force_point. Unit quad4, E = 1, nu = 0, x fixed
at nodes 1 3, y fixed at nodes 1 2. node_force (1, 0) at nodes 2 and 4:
a uniaxial bar with sigxx = 2 and disx(2) = disx(4) = 2
(= Professional 02-08-2026). GNU before C28: -2 (the force was
subtracted from node_rhside).
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1
group_materi_elasti_poisson 0 0
group_materi_memory 0 -total_linear
bounda_dof 0 1 -velx
bounda_dof 1 3 -velx
bounda_dof 2 1 -vely
bounda_dof 3 2 -vely
bounda_time 0 0 0 1 0
bounda_time 1 0 0 1 0
bounda_time 2 0 0 1 0
bounda_time 3 0 0 1 0
node_force 2 1.0 0.0
node_force 4 1.0 0.0
control_timestep 0 1 1
target_item    1  -node_dof 2 -disx
target_value   1  2.0 1.e-8
target_item    2  -node_dof 4 -disx
target_value   2  2.0 1.e-8
end_data
