( F4 T3 / C33: full principal Mohr-Coulomb direct cut-off phi 0 c 1e-3, no
  normal, plus tension_direct 0, sheared quad4 sigxy trial 2.4e-3, one step
  dt 1. Each law relaxes with its own _visco: tension cap tm 4, MC tm 2:
  sigxx -2.654391e-4, sigxy 1.688146e-3 = Professional 02-08-2026. Old GNU:
  -1.2e-3 / 1.2e-3, full tension cap and no MC relaxation in step 1. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_stress
end_initia
node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
element 1  -quad4 1 2 3 4
group_type 0  -materi
group_materi_elasti_young 0  1.
group_materi_elasti_poisson 0  0.25
group_materi_plasti_mohr_coul_direct 0  0. 1.e-3 0.
group_materi_plasti_mohr_coul_direct_visco 0  2.
group_materi_plasti_tension_direct 0  0.
group_materi_plasti_tension_direct_visco 0  4.
mesh -fixed_in_space -fixed_in_space
bounda_dof 0  -ra 1 2 -ra -velx
bounda_time 0  0.
bounda_dof 1  -ra 3 4 -ra -velx
bounda_time 1  6.e-3
bounda_dof 2  -ra 1 2 3 4 -ra -vely
bounda_time 2  0.
control_timestep 0  1. 1.
target_item 0 -node_dof 1 -sigxx
target_value 0 -2.654391e-4 1.e-8
target_item 1 -node_dof 1 -sigxy
target_value 1 1.688146e-3 1.e-8
end_data
