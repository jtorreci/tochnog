(
K04 ground9 / Pro condif11 (2026-10-06): group_interface_condif_conductivity
is per unit length (manual Professional 6.625), so each facing node pair
carries its tributary length (Lobatto weight x side length). Thermal
analog of ground9 (width 1): conduction 0.1 in element 1, interface
conductivity 0.1, temp 1 at the bottom and 0 at the top: middle temp
0.5 (= Professional 02-08-2026, = Pro condif11 target). GNU before K04:
1/3 (pair conductance k without the length: 0.2).
)
echo -no
number_of_space_dimensions 2
condif_temperature
end_initia

node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
node 5  0 2
node 6  1 2

element 1  -quad4 1 2 3 4
element_group 1 0

element 2  -quad4 3 4 5 6 
element_group 2  1

bounda_dof 0  -ra 1 2 -ra -temp
bounda_time    0  0.0 0.0 1. 1. 100. 1.
bounda_dof 1  -ra 5 6 -ra -temp
bounda_time    1  0.0 0.0 100.0 0.

group_type 0  -condif
group_condif_conductivity 0 0.1

group_type 1  -condif
group_interface 1  -yes
group_interface_condif_conductivity 1  0.1


print_filter 0  -node_dof -all -temp

control_timestep  0  1. 1.
(control_print     0  -time_current -node_dof)

target_item 0   -node_dof 3 -temp
target_value   0   0.5 1.e-6
end_data
