( F4 T4 / K20: thick ring under internal pressure [J. Akin 1995, one
  axisymmetric quad4, r 10..11, p 1000, E 1e7, nu 0.3]. 2x2 Gauss as the
  Professional 02-08-2026: post_point 1 [inner radius] disx
  1.081776788020e-02 [= Professional to 1e-12], sigzz 10760.09
  [Professional 10759.22: the nodal recovery of the quad4 differs, see
  BACKLOG C42; analytic hoop stress 10910]. Old GNU: forced 1-point rule,
  element-constant hoop term, disx 1.08238e-02, sigzz 10000. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  10. 0.
node 2  11.0 0.
node 3  10.0 1.
node 4  11.0 1.
element 1  -quad4 1 2 3 4

group_type 0  -materi
group_axisymmetric 0 -yes
group_materi_elasti_young 0  1.0e7
group_materi_elasti_poisson 0  0.3
group_materi_memory 0  -total_linear

(inner radius)
geometry_line  1  10. 0. 10. 1. 1.e-4
(lower edge)
geometry_line  2  10. 0. 11. 0. 1.e-4

bounda_dof 2  -geometry_line 2 -vely 
bounda_time    2  0. 0. 100. 0.

force_edge 0  1000. 0.
force_edge_geometry 0  -geometry_line 1
force_edge_time 0  0.0 1.0 1.0 1.0

post_point 1  10. 0.

control_timestep  10  1. 1.
target_item 1  -post_point_dof 1 -disx
target_value 1  1.081776788020e-02 1.e-12
target_item 2  -post_point_dof 1 -sigzz
target_value 2  10759.22 1.
end_data
