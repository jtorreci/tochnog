(control_print_gid_beam_vectors [6.295] -yes: results beam_vectors_0..5 =
 f_k [t x n] on the 2 Gauss points [f_k = -force_moment[k] at node 1,
 force_moment[6+k] at node 2]. Element 1: beam_vectors_5 [0,-4] and [0,-2];
 element 2: beam_vectors_1 [1,-1] [= Professional 02-08-2026].
 Model: two truss_beam elements [1-2 along x, 2-3 at 45 degrees], node 1
 clamped, force vely 2 on node 3 at t 1.
 build_safe.sh runs it in a scratch copy and checks the .flavia files.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
beam_rotation
end_initia
node 1 0 0
node 2 1 0
node 3 2 1
element 1 -truss_beam 1 2
element 2 -truss_beam 2 3
group_type 0 -truss_beam
group_beam_young 0 1.0e3
group_beam_shear 0 1.0e3
group_beam_inertia 0 1. 1. 1.
group_beam_memory 0 -total_linear
group_truss_area 0 1.
group_truss_elasti_young 0 1.e3
group_truss_memory 0 -total_linear
bounda_dof 0 1 -velx -vely -rotz
bounda_time 0 0.
bounda_force 1 3 -vely
bounda_time 1 0. 0. 1. 2.
control_timestep 10 1. 1.
control_print_gid 10 -yes
control_print_gid_beam_vectors 10 -yes
end_data
