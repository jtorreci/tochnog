( F5 T4 U9e: a keep geometry with only nodes 7 8 of element 2: the
  element is not kept and becomes active again (= Professional
  02-08-2026). A keep geometry of index 10 only does not act at 20. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0. 0.
node 2 1. 0.
node 4 0. 1.
node 5 1. 1.
node 7 0. 2.
node 8 1. 2.
element 1 -quad4 1 2 4 5
element 2 -quad4 4 5 7 8
element 3 -quad4 4 5 7 8
element_group 2 2
element_group 3 1
group_type -ra 0 1 2 -ra -materi
group_materi_elasti_young -ra 0 1 2 -ra 1000.
group_materi_elasti_poisson -ra 0 1 2 -ra 0.2
group_materi_density -ra 0 1 2 -ra 1.
force_gravity 0. -10.
bounda_dof 1 -ra 1 2 -ra -velx -vely
control_mesh_remove 10 -method1 2 1
control_mesh_remove_really 10 -no
control_timestep 10 1. 1.
control_print_database 10 -yes
geometry_line 1 -0.1 2. 1.1 2. 0.01
geometry_quadrilateral 2 -0.1 0.9 1.1 0.9 -0.1 2.1 1.1 2.1 0.01
control_mesh_remove_keep_geometry 10 -geometry_quadrilateral 2
control_mesh_remove_keep_geometry 20 -geometry_line 1
control_mesh_remove 20 -method1 7 8
control_timestep 20 1. 1.
control_print_database 20 -yes
end_data
