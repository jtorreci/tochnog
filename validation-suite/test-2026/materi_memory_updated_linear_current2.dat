( F3/C19: explicit -updated_linear on a -follow_material mesh. Two-quad4
  column, bottom fixed, top moved 1 in x in 100 steps, young 1, poisson
  0. Professional 02-08-2026: node 3 velix 0.520931. GNU gives 0.520480:
  the 0.1 percent residual is the documented in-step geometry divergence
  (GNU evaluates the -follow_material gradient at the end-of-step
  geometry, the Professional at the start-of-step geometry, see
  DIVERGENCES-PROFESSIONAL.md), hence the 1.e-3 tolerance. Before F3 GNU
  used the reference-geometry gradient and gave 0.472222. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
node 5 0 2
node 6 1 2
element 1 -quad4 1 2 3 4
element 2 -quad4 3 4 5 6
group_type 0 -materi
group_materi_elasti_young 0 1.0
group_materi_elasti_poisson 0 0.0
group_materi_memory 0 -updated_linear
mesh -follow_material -follow_material
bounda_dof 0 -ra 1 2 -ra -velx -vely
bounda_dof 1 -ra 5 6 -ra -velx
bounda_dof 2 -ra 5 6 -ra -vely
bounda_time 1 1.
control_timestep 0 0.01 1.0
control_timestep_iterations 0 100
target_item 0  -node_dof 3 -velix
target_value 0  0.52093 0.001
end_data
