( F4 T8 C46d: control_mesh_macro -rectangle node and element numbering.
  The Professional 02-08-2026 numbers x fastest, then y, also the
  elements and the local element nodes: node 2 at 1 0, node 4 at 0 1,
  element 1 -quad4 1 2 4 5. Old GNU: y fastest [node 2 at 0 1].
  build_safe.sh checks the .dbs. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_stress
end_initia
geometry_brick 1  0. 0. 0. 400. 400. 400. 1.e-4
bounda_dof 1 -geometry_brick 1 -velx -vely
group_type 0  -materi
group_materi_elasti_young   0  1.0e6
group_materi_density   0  1.0
control_mesh_macro 0   -rectangle 0 3 3
control_mesh_macro_parameters 0   1. 1. 2. 2.
control_timestep 0 0.1 0.1
end_data
