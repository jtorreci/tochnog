( F3/C19: explicit -updated_linear integrates the velocity gradient on
  the current geometry (manual Professional 2.2.1). Single quad4 bar
  stretched by 50 percent in 50 steps, velocity kinematics, young 1,
  poisson 0, group_materi_memory -updated_linear, mesh -follow_material.
  sigxx = 0.407136 (incremental strains summed on the current
  geometry); Professional 02-08-2026 gives 0.4071364. Before F3 GNU used
  the reference-geometry gradient and gave 0.5. )
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1.0
group_materi_elasti_poisson 0 0.0
group_materi_memory 0 -updated_linear
mesh -follow_material -follow_material
bounda_dof 0 -ra 1 3 -ra -velx
bounda_dof 1 1 -vely
bounda_dof 2 -ra 2 4 -ra -velx
bounda_time 2 1.0
control_timestep 0 0.01 0.5
control_timestep_iterations 0 20
target_item 0  -node_dof 2 -sigxx
target_value 0  0.4071364 1e-06
end_data
