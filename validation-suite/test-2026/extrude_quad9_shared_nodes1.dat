( F4 T12 / BACKLOG C47: control_mesh_extrude of -quad9 elements into
  -hex27 with control_mesh_extrude_n 2 1 [two hex27 layers, as
  force11]. Two quad9 side by side [x 0..2, y 0..1] extruded to z
  0..1: a cantilever plate clamped on x = 0 with a -y edge force on x
  = 2. The inner planes [z = 0.25, 0.5, 0.75] must hold ONE node per
  source node, shared by the neighbouring hex27, as in the
  Professional: 15 nodes per plane, 75 nodes in all [build_safe.sh
  counts the node records of the .dbs; old GNU: per-element plane
  nodes, 84 nodes, the two elements and the two layers disconnected at
  the inner planes, a much softer plate]. Targets: the Professional
  02-08-2026 nodal displacements at the same coordinates [GNU node 83
  = (2, 1, 0.5), 66 = (2, 1, 0.25), 71 = (1, 0, 0.5); the Professional
  numbers its planes compactly, 45, 30 and 33; the new GNU matches to
  2e-12]. Old GNU: node 83 disy -6.37e-5 at (2, 0.5, 0.5). )
echo -no
number_of_space_dimensions 3
materi_velocity
materi_displacement
materi_stress
end_initia

start_define
  x_start geometry_quadrilateral 1
end_define
x_start  0. 0. 0.   0. 1. 0.   0. 0. 1.   0. 1. 1.  1.e-4
start_define
  x_end geometry_quadrilateral 2
end_define
x_end  2. 0. 0.   2. 1. 0.   2. 0. 1.   2. 1. 1.  1.e-4

bounda_dof  1  -x_start -velx -vely -velz
bounda_time 1  0. 0. 100. 0.

force_edge          1  0. -1. 0.
force_edge_geometry 1  -x_end

group_type 0  -materi
group_materi_memory 0  -total_linear
group_materi_elasti_young   0  1.e6
group_materi_elasti_poisson 0  0.3

control_mesh_extrude   0  0. 1.
control_mesh_extrude_n 0  2 1
control_timestep 0  1. 1.

target_item  1  -node_dof 83 -disy
target_value 1  -3.518022736454e-05 1.e-9
target_item  2  -node_dof 66 -disx
target_value 2  1.152330040463e-05 1.e-9
target_item  3  -node_dof 71 -disx
target_value 3  -8.528985668923e-06 1.e-9

node  1  0.0 0.0 0.
node  2  0.5 0.0 0.
node  3  1.0 0.0 0.
node  4  1.5 0.0 0.
node  5  2.0 0.0 0.
node  6  0.0 0.5 0.
node  7  0.5 0.5 0.
node  8  1.0 0.5 0.
node  9  1.5 0.5 0.
node 10  2.0 0.5 0.
node 11  0.0 1.0 0.
node 12  0.5 1.0 0.
node 13  1.0 1.0 0.
node 14  1.5 1.0 0.
node 15  2.0 1.0 0.
element 1 -quad9  1  2  3   6  7  8  11 12 13
element 2 -quad9  3  4  5   8  9 10  13 14 15
end_data
