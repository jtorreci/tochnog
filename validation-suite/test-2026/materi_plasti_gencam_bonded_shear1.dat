(Bonded-soil generalised Cam clay (group_materi_plasti_generalised_non_associate_cam_clay_for_bonded_soils). Constant-volume triaxial
 compression of the element of gencam_bonded_iso1 with xi_s = 0.5 and xi_m = 1 (shear hardening of
 p_s, shear debonding of p_m). The final state lies on the yield surface (independent quadrature of
 the Lagioia-Puzrin-Potts integral: f/p_c = 2e-9) and the plastic flow follows the dilatancy of the
 potential, d = mu_g (M_g - eta) (alpha_g M_g/eta + 1), to the first order of the step (the flow
 direction is taken at the elastic trial stress). The targets pin the state at eps_yy = -0.1.)

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_strain_plasti
materi_strain_plasti_generalised_non_associate_cam_clay_for_bonded_soils
materi_stress
materi_plasti_generalised_non_associate_cam_clay_for_bonded_soils_history
end_initia

node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1

element 1  -quad4 1 2 3 4

start_define
  left_edge  geometry_line 0
end_define
start_define
  lower_edge geometry_line 1
end_define
start_define
  upper_edge geometry_line 2
end_define
start_define
  right_edge geometry_line 3
end_define

left_edge  0. 0. 0. 1.  1.e-5
lower_edge 0. 0. 1. 0.  1.e-5
upper_edge 0. 1. 1. 1.  1.e-5
right_edge 1. 0. 1. 1.  1.e-5

bounda_dof     0  -left_edge  -velx
bounda_time    0  0. 0. 100. 0.
bounda_dof     1  -lower_edge -vely
bounda_time    1  0. 0. 100. 0.
bounda_dof     2  -upper_edge -vely
bounda_time    2  0. -1. 100. -1.
bounda_dof     3  -right_edge  -velx
bounda_time    3  0. 0.5 100. 0.5

group_type                     0  -materi
group_materi_memory            0  -total_linear
group_materi_elasti_young      0  10000.
group_materi_elasti_poisson    0  0.25
group_materi_plasti_generalised_non_associate_cam_clay_for_bonded_soils 0
  0.9 0.4 1.1  0.9 0.4 1.2  10. 0.5  5. 1.  0.1
group_axisymmetric             0 -yes

post_point 1  0.5 0.5

control_reset_dof                1 -sigxx -sigyy -sigzz
control_reset_value_constant     1 -100.
control_reset_dof                2 -gencamhis0
control_reset_value_constant     2 100.
control_reset_dof                3 -gencamhis1
control_reset_value_constant     3 50.

control_timestep                20   0.00005 0.1

target_item    0  -post_point_dof 1 -sigxx
target_value   0  -49.0401203811 1.e-3
target_item    1  -post_point_dof 1 -sigyy
target_value   1  -156.770862524 1.e-3
target_item    2  -post_point_dof 1 -gencamhis0
target_value   2  161.23401599 1.e-3
target_item    3  -post_point_dof 1 -gencamhis1
target_value   3  30.7891585012 1.e-4
end_data
