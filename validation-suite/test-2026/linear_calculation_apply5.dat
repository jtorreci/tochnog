(
F5 W1 U6: linear_calculation_apply -yes, the database rewrite (manual
 Professional 6.797, checked in the .dbs by build_safe.sh, = the .dbs of the
 Professional 02-08-2026 except where noted):
 plasti_apply -no, mesh -fixed_in_space -fixed_in_space and contact_apply -no
 are added (the Professional adds contact_apply -no and keeps the other
 contact_* records; the GNU deletes them as the manual says);
 group_*_memory -updated -> -updated_linear (no materi_displacement);
 group_spring_stiffness_nonlinear -1 50 1 150 -> group_spring_stiffness 100
 (the stiffness at strain 0); dependency_item/_diagram 0 on the dof -vely
 deleted, dependency 1 on -time_current kept; group_materi_failure_rupture
 deleted.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_stress
materi_strain_total
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
element 2 -spring2 1 4
element_group 2 1
group_type 0 -materi
group_type 1 -spring
group_materi_elasti_young 0 1000
group_materi_elasti_poisson 0 0.
group_materi_memory 0 -updated
group_materi_failure_rupture 0 1.e10 0.
group_spring_direction 1 0 1
group_spring_stiffness_nonlinear 1 -1 50 1 150
group_spring_memory 1 -updated
dependency_item 0 -group_materi_elasti_young 0 -vely 2
dependency_diagram 0 -1 0 500 1000
dependency_item 1 -group_materi_elasti_poisson 0 -time_current 2
dependency_diagram 1 0 10 0 0
contact_penalty_velocity 1.e3
bounda_dof 0 -ra 1 2 -ra -vely
bounda_dof 1 -ra 1 3 -ra -velx
bounda_dof 2 -ra 3 4 -ra -vely
bounda_time 2 0 0 1 -0.01
control_timestep 0 1 1
linear_calculation_apply -yes
end_data
