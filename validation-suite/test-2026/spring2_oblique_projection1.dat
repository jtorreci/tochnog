( C88 {F4 T6f, 2026-10-19}: spring elongation = relative displacement projected on the spring direction {Professional 02-08-2026}.
  A -spring2 {k 10} from {0,0} to {1,0} with group_spring_direction 1 1;
  node 2 moved {0.3,0.1} in one step. Spring force = k {0.3+0.1}/sqrt{2}
  = 2.828427124746 {Professional}; the node-distance elongation gave
  3.0384. )
echo -no
