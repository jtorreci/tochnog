( F5 T5 U5: force_edge_diagram (manual 6.455) takes the factor from the
  vertical displacement dof; without materi_displacement (updated_linear memory) GNU stops.
  EXPECTED_ERROR: Error: force_edge_diagram needs materi_displacement
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 2 0
node 4 0 1
node 5 1 1
node 6 2 1
element 1 -quad4 1 2 4 5
element 2 -quad4 2 3 5 6
element_group 1 0
element_group 2 1
group_type 0 -materi
group_materi_elasti_young 0 10
group_materi_elasti_poisson 0 0
group_materi_memory 0 -updated_linear
group_type 1 -materi
group_materi_elasti_young 1 100
group_materi_elasti_poisson 1 0
group_materi_memory 1 -updated_linear
bounda_dof 0 1 -velx -vely
bounda_dof 1 2 -velx -vely
bounda_dof 2 3 -velx -vely
bounda_dof 3 4 -velx
bounda_dof 4 5 -velx
bounda_dof 5 6 -velx
force_edge 0 0 -1
geometry_line 1 0 1 2 1 1.e-3
force_edge_geometry 0 -geometry_line 1
force_edge_diagram 0 -1. 0. 0. 1.
control_timestep 0 1 1
end_data
