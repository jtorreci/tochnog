(
F5 W2 V1: 2026 manual names that are aliases of GNU records:
 materi_strain_energy (4.28) and materi_history_variable (4.14) in the
 initialization part; control_print_vtk_node_type (6.345),
 control_print_gmsh_node_type (6.319), control_print_dof_line_node_type
 (6.279) and post_node_rhside_ratio_dof_type (6.951) in the data part.
 build_safe checks that the records are stored under the GNU names.
 Geometry of control_post1.
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
materi_strain_elasti
materi_strain_energy
materi_history_variable 2
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_memory 0 -total_linear
group_materi_elasti_young 0 1000.
group_materi_elasti_poisson 0 0.3
geometry_line 1 0 0 1 0 0.01
geometry_line 2 0 0 0 1 0.01
geometry_line 3 0 1 1 1 0.01
bounda_dof 0 -geometry_line 1 -vely
bounda_dof 1 -geometry_line 2 -velx
bounda_dof 2 -geometry_line 3 -vely
bounda_time 2 0 0 1 0.02
post_point 0 0.5 0.5
post_element_force 0 0. 1. 0. 0. 0.5 0.
post_element_force_geometry 0 -geometry_line 1
control_timestep 0 0.1 0.5
control_print_vtk_node_type 0 -node_deformed_mesh
control_print_gmsh_node_type 0 -node
control_print_dof_line_node_type 0 -node_start_refined
post_node_rhside_ratio_dof_type -materi_velocity
check_combination -no
end_data
