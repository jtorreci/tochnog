( Copy of the Professional 02-08-2026 example test/other/truss15.dat
  [_exact 6.250, 1D]: the truss 1..5 is split into four pieces, the new
  nodes 6 7 8 [Professional 7 8 9] are tied to the bar nodes 2 3 4; target
  = Professional. )
( Automatic distribution of truss. )
( The force at the right edge causes a displacement of 5.e-2 )

echo -no
number_of_space_dimensions 1
materi_velocity
materi_displacement
materi_stress
end_initia

geometry_point 10  0.0 1.e-2
geometry_point 20  100.0 1.e-2

node 1   0
node 2  25
node 3  50
node 4  75
node 5  100
element 1  -bar2 1 2
element 2  -bar2 2 3
element 3  -bar2 3 4
element 4  -bar2 4 5
element 5  -truss 1 5
element_group 5  1

group_type 0  -materi
group_materi_elasti_young 0  1.0
group_materi_memory 0  -total_linear

group_type 1  -truss
group_truss_area 1  1.
group_truss_memory 1  -total_linear
group_truss_elasti_young 1  1.

bounda_dof 10  -geometry_point 10 -velx
bounda_force 20  -geometry_point 20 -velx
bounda_time 20  1.0e-3

post_point 10  100.0

control_mesh_truss_distribute_mpc 10 -yes
control_mesh_truss_distribute_mpc_exact 10  -yes
control_mesh_truss_distribute_mpc_element_group_truss 10 1

control_timestep 10 1. 1.
(
control_print 10 -time_current -node_dof
)

target_item  0   -post_point_dof 10 -disx
target_value 0   5.e-2 1.e-2
end_data
