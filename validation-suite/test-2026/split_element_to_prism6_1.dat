( F5 T4 U5b: Professional 02-08-2026 test/other/prism6 [comment
  shortened]: control_mesh_split -yes with control_mesh_split_element_to
  -prism6 [6.242] splits the hex8 in two prism6, 1 2 3 5 6 7 and
  2 4 3 6 8 7 [= Professional mesh]; the prism6 is strained 1 in z and
  the post_point sigzz must become 1. Needs point_el for -prism6
  [BACKLOG C125; before: assertion abort]. )

echo -no
number_of_space_dimensions 3
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  0.0 0.0 0.0
node 2  1.0 0.0 0.0
node 3  0.0 1.0 0.0
node 4  1.0 1.0 0.0
node 5  0.0 0.0 1.0
node 6  1.0 0.0 1.0
node 7  0.0 1.0 1.0
node 8  1.0 1.0 1.0
element 1  -hex8 1 2 3 4 5 6 7 8

start_define
  lower_edge geometry_quadrilateral 1
end_define
start_define
  upper_edge geometry_quadrilateral 2
end_define

lower_edge 0. 0. 0. 1. 0. 0. 0. 1. 0. 1. 1. 0. 1.e-5
upper_edge 0. 0. 1. 1. 0. 1. 0. 1. 1. 1. 1. 1. 1.e-5

group_type 0  -materi
group_materi_elasti_young 0  1.0
group_materi_memory 0  -total_linear

bounda_dof   0   -lower_edge -velx -vely -velz
bounda_time      0   0. 0. 100. 0.
bounda_dof   1   -upper_edge -velz
bounda_time      1   0. 1. 100. 1.

post_point       1  0.1 0.1 0.1

control_mesh_split              20  -yes
control_mesh_split_element_to   20  -prism6

control_timestep             30  1. 1.
(
control_print                30  -node_dof -post_point_dof
)

target_item  1 -post_point_dof 1 -sigxx
target_value 1 0. 1.e-4
target_item  2 -post_point_dof 1 -sigyy
target_value 2 0. 1.e-4
target_item  3 -post_point_dof 1 -sigzz
target_value 3 1. 1.e-4
end_data
