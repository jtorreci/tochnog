( F5 T4 U5b: control_mesh_split -yes on two tria6 and a quad4 [6.240]:
  each tria6 becomes four tria3 on its corner and mid-side nodes, the
  quad4 four tria3 around a new centre node. Before U5b the GNU did not
  split tria6. Mesh = Professional 02-08-2026. )
echo -no
number_of_space_dimensions 2
end_initia
node 1 0. 0.
node 2 1. 0.
node 3 2. 0.
node 4 0. 1.
node 5 1. 1.
node 6 0. 2.
node 7 2. 2.
node 8 1. 2.
node 9 2. 1.
node 10 3. 0.
node 11 3. 1.
element 1 -tria6 1 2 3 4 5 6
element 2 -tria6 3 9 7 5 8 6
element 3 -quad4 3 10 9 11
control_mesh_split 10 -yes
end_data
