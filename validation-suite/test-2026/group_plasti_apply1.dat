(F5 W1: group_plasti_apply 1 -no, manual Pro 6.762: two identical 1D bars,
 the plasticity of group 1 is neglected, group 0 yields. Professional
 02-08-2026: group 0 sigxx 1, group 1 sigxx 3.)
echo -no
number_of_space_dimensions 1
materi_velocity
materi_displacement
materi_strain_total
materi_strain_plasti
materi_stress
end_initia
node 1  0
node 2  1
element 1  -bar2 1 2
node 3 0
node 4 1
element 2 -bar2 3 4
element_group 2 1
bounda_dof 0  1 -velx
bounda_time 0  0.
bounda_dof 1  2 -velx
bounda_dof 2 3 -velx
bounda_time 2 0.
bounda_dof 3 4 -velx
bounda_time 3 1.
bounda_time 1  1.
group_type 0  -materi
group_type 1  -materi
group_materi_elasti_young 0  2.0
group_materi_elasti_young 1  2.0
group_materi_memory 0  -total_linear
group_materi_memory 1  -total_linear
group_materi_plasti_tension 0  1.
group_materi_plasti_tension 1  1.
control_timestep 0  0.5 0.5
control_timestep 1  1. 1.
group_plasti_apply 1 -no
target_item 0 -node_dof 1 -sigxx
target_value 0 1. 1.e-6
target_item 1 -node_dof 3 -sigxx
target_value 1 3. 1.e-6
end_data
