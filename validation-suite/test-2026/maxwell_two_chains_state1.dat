(C68d, F4 T6f: the old-state read loop of materi() reused the Maxwell
 chain index for old_rho / old_epi / old_epp, so with two or more chains
 the kinematic hardening rho and the plastic strain did not accumulate
 (and the reads overran the 9-entry arrays). Two identical Maxwell chains
 (E 1000, tau 0.5) are linear, so they must equal one chain (E 2000,
 tau 0.5): targets = the one-chain run of the same model (GNU, code path
 not affected by the defect), each chain carrying half the Maxwell
 stress. Von Mises with kinematic hardening, four tria3, rhoyy / eppyy
 and the reactions. HEAD before the fix: node 1 reaction -13.32
 instead of -19.17.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
materi_strain_total
materi_strain_plasti
materi_plasti_rho
materi_maxwell_stress 2
end_initia
node 1 0 0
node 2 1 0
node 3 2 0
node 4 0 1
node 5 1 2
node 6 2 1
element 1 -tria3 1 2 4
element 2 -tria3 2 5 4
element 3 -tria3 2 3 5
element 4 -tria3 3 6 5
bounda_dof 0 1 -velx -vely
bounda_time 0 0. 0. 1.e10 0.
bounda_dof 1 2 -vely
bounda_time 1 0. 0. 1.e10 0.
bounda_dof 2 3 -vely
bounda_time 2 0. 0. 1.e10 0.
bounda_dof 3 4 -vely
bounda_time 3 0. -0.01 1.e10 -0.01
bounda_dof 4 5 -vely
bounda_time 4 0. -0.01 1.e10 -0.01
bounda_dof 5 6 -vely
bounda_time 5 0. -0.01 1.e10 -0.01
group_type 0 -materi
group_materi_elasti_young 0 7.e3
group_materi_elasti_poisson 0 0.2
group_materi_memory 0 -total_linear
group_materi_membrane 0 -yes
group_materi_plasti_vonmises 0 24.3
group_materi_plasti_kinematic_hardening 0 2000.
group_materi_maxwell_chain 0 1.e3 0.5 1.e3 0.5
control_timestep 10 0.1 1.
target_item 0 -node_rhside 1 -vely
target_value 0 -1.917164865160e+01 1.92e-05
target_item 1 -node_rhside 2 -vely
target_value 1 -3.452518903510e+01 3.45e-05
target_item 2 -node_rhside 4 -vely
target_value 2 2.749838276860e+01 2.75e-05
target_item 3 -node_dof 1 -rhoyy
target_value 3 -9.774293416060e+00 9.77e-06
target_item 4 -node_dof 6 -eppyy
target_value 4 -5.358871405090e-03 5.36e-09
target_item 5 -node_dof 1 -1msigyy
target_value 5 -1.728401613470e+00 1.73e-06
target_item 6 -node_dof 1 -2msigyy
target_value 6 -1.728401613470e+00 1.73e-06
end_data
