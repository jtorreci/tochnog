( F5 T5 U2: control_slide_damping_apply -no (manual 6.370) switches the
  slide_damping off: the results equal the Professional 02-08-2026 for the
  same input (and for the input without slide_damping).
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_stress
end_initia
start_define
  bottom geometry_line 1
end_define
bottom 0. 0. 1. 0. 1.e-4
start_define
  top geometry_line 2
end_define
top 0. 1. 1. 1. 1.e-4
node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
element 1  -quad4 1 2 3 4
group_type 0  -materi
group_materi_elasti_young 0  1.0
bounda_dof     0  -top -vely
bounda_time    0  0. -1.e-2 1.e10 -1.e-2
bounda_dof     1  -top -velx
bounda_time    1  0. 1. 1.e10 1.
slide_geometry 10  -bottom
slide_stiffness 10  1.e3 1.e3
slide_damping 10  100. 10.
control_slide_damping_apply 0 -no
control_timestep 0  1.e-2 0.5
target_item  0  -node_slide_force 1 0
target_value 0  1.224075618343e-01 1.e-8
target_item  1  -node_slide_force 1 1
target_value 1  -1.249375390371e-01 1.e-8
target_item  2  -node_slide_force 2 0
target_value 2  -1.274050630837e-01 1.e-8
end_data
