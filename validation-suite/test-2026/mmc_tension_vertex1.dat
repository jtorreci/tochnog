(F4 T6f [dt 0.05], class A divergence MC-VERTEX-ZZ, owner decision 2026-10-12.
 Copy of test-2014 mmc_tension: classic Mohr-Coulomb [phi 0.5236 rad,
 c 40, psi 0], plane strain, nu 0, uniaxial tension, no tension cut-off.
 sigxx = 2 c cos phi / [1 + sin phi] = 46.188 [analytic]. At the MC
 vertex sigyy = sigzz = 0: any plastic eppzz > 0 would leave the vertex,
 so the continuum solution has sigzz = 0 and eppzz = 0. GNU sigzz ~1e-9,
 eppzz ~1e-12. The Professional 02-08-2026 gives a dt-dependent vertex
 artefact: sigzz 0.974 / eppzz -9.7e-4 at dt 0.05, 0.367 at dt 0.047,
 1.44 at dt 0.0047, 0 at dt 0.1; these targets reject it.
 DIVERGENCES-PROFESSIONAL.md MC-VERTEX-ZZ.)
echo -no
number_of_space_dimensions 2
derivatives
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_strain_plasti
materi_stress
number_of_integration_points 4
end_initia

bounda_time  0  0 0 100 0
bounda_time  1  0 1 100 1
bounda_time  2  0 0 100 0
bounda_unknown  0  -ra 1 3 -ra -velx
bounda_unknown  1  -ra 2 4 -ra -velx
bounda_unknown  2  -ra 1 2 -ra -vely
control_timestep  0  0.05 0.5
element  1  -quad4 1 2 3 4
element_group  1  0
group_materi_density  0  1
group_materi_elasti_poisson  0  0
group_materi_elasti_young  0  1000
group_materi_memory  0  -updated_without_rotation
group_materi_plasti_mohr_coul  0  0.5236 40 0
group_type  0  -materi
node  1  0 0
node  2  1 0
node  3  0 1
node  4  1 1
options_mesh   -fixed_in_space -fixed_in_space
options_processors   1
options_stabilization   -static
post_point  1  0.5 0.5
target_item  1  -post_point_dof 1 -sigxx
target_value  1  46.19 0.2
target_item  2  -post_point_dof 1 -sigzz
target_value  2  0. 0.05
target_item  3  -post_point_dof 1 -eppzz
target_value  3  0. 1.e-4
