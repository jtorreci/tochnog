( F5 T5 U3a: groundflow_phreatic_only -no: the groups keep their
  groundflow data (build_safe.sh greps group_type 2 in the .dbs).
)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
groundflow_pressure
groundflow_velocity
end_initia
node 1  0 0
node 2  1 0
node 3  0 1
node 4  1 1
node 5  0 2
node 6  1 2
node 7  0 3
node 8  1 3
element 1  -quad4 1 2 3 4
element 2  -quad4 3 4 5 6
element 3  -quad4 5 6 7 8
element_group 1 1
element_group 2 1
element_group 3 2
force_gravity 0. -1.
groundflow_density 1.
groundflow_phreatic_level_multiple 0 2.5
groundflow_phreatic_level_multiple_element_group 0 1
groundflow_phreatic_only -no
bounda_dof 1 -ra 1 2 -ra -velx -vely
bounda_time 1 0.
bounda_dof 2 -ra 1 2 -ra -pres
bounda_time 2 0. -0.5 10. -0.5
post_calcul -groundflow_pressure -total_pressure
group_type 1  -materi -groundflow
group_materi_elasti_young 1 1000.
group_materi_elasti_poisson 1 0.2
group_materi_density 1 2.
group_groundflow_permeability 1  0.1 0.1
group_type 2  -materi -groundflow
group_materi_elasti_young 2 1000.
group_materi_elasti_poisson 2 0.2
group_materi_density 2 2.
group_groundflow_permeability 2  0.1 0.1
control_timestep   10  1. 1.
control_print_database 10 -yes
end_data
