( SMC-GLUED-LINE-END: file 48.smc is the file of bounda_time_smc_glued1
  with LF lines. The GNU reads the same samples k = 0..9 whatever the line
  end: at t = 4 accx 8, velx 17, disx 25.5. The Professional 02-08-2026
  inserts a zero sample after each LF line of 80 glued columns {accx 0,
  velx 14, disx 24.5}, but not with CRLF lines: deliberate divergence. )
echo -no
number_of_space_dimensions 1
materi_acceleration
materi_velocity
materi_displacement
end_initia
inertia_apply -yes
node 1  0
node 2  1
element 1  -truss 1 2
group_type 0  -truss
group_truss_area 0  1.0
group_truss_elasti_young 0  1.0
group_truss_density 0  2.0
bounda_dof 48 1 -accx
bounda_time_smc 48 -yes
bounda_time_smc_units 48 1. 1.
control_timestep 10 0.25 4.
target_item 0 -node_dof 1 -accx
target_value 0 8. 1.e-8
target_item 1 -node_dof 1 -velx
target_value 1 17. 1.e-8
target_item 2 -node_dof 1 -disx
target_value 2 25.5 1.e-8
end_data
