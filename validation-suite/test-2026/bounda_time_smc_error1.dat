( bounda_time_smc: an ACCELEROGRAM file on a -velx dof is an input error,
  as in the Professional 02-08-2026.
  EXPECTED_ERROR: Error, the SMC file is for type: materi_acceleration
)
echo -no
number_of_space_dimensions 1
materi_acceleration
materi_velocity
materi_displacement
end_initia
inertia_apply -yes
node 1  0
node 2  1
element 1  -truss 1 2
group_type 0  -truss
group_truss_area 0  1.0
group_truss_elasti_young 0  1.0
group_truss_density 0  2.0
bounda_dof 49 1 -velx
bounda_time_smc 49 -yes
bounda_time_smc_units 49 1. 1.
control_timestep 10 0.25 1.
end_data
