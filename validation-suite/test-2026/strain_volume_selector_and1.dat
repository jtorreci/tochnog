( strain_volume_* selectors in one index are combined as an intersection
  {Professional 02-08-2026; the manual does not say how they combine}:
  strain_volume_element 10 1 with strain_volume_element_group 10 0 1 selects
  element 1 only {element 2 is in group 1 but not in the element list}.
  Professional: initial 4, absolute 0.500620296504, relative 12.515507412.
)
echo -no
number_of_space_dimensions 3
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0 0
node 2 2 0 0
node 3 0 2 0
node 4 2 2 0
node 5 0 0 1
node 6 2 0 1
node 7 0 2 1
node 8 2 2 1
node 9 0 0 3
node 10 2 0 3
node 11 0 2 3
node 12 2 2 3
element 1 -hex8 1 2 3 4 5 6 7 8
element 2 -hex8 5 6 7 8 9 10 11 12
element_group 2 1
group_type 0 -materi
group_type 1 -materi
group_materi_elasti_young 1 1.0e6
group_materi_elasti_poisson 1 0.2
group_materi_memory 1 -total_linear
group_materi_elasti_young 0 1.0e6
group_materi_elasti_poisson 0 0.2
group_materi_memory 0 -total_linear
bounda_dof 10 -ra 1 3 5 7 9 11 -ra -velx
bounda_dof 20 -ra 1 2 5 6 9 10 -ra -vely
bounda_dof 30 -ra 1 2 3 4 -ra -velz
strain_volume_absolute_time 10 0. 0. 1. 0.6
strain_volume_element 10 1
strain_volume_element_group 10 0 1
control_timestep 10 1. 1.
target_item    1  -post_strain_volume_absolute 10 0
target_value   1  0.500620296504 1.e-8
target_item    2  -post_strain_volume_initial 10 0
target_value   2  4. 1.e-10
target_item    3  -post_strain_volume_relative 10 0
target_value   3  12.515507412 1.e-8
end_data
