( element_normal companion of element_normal2d_row_error1: the same
  single row of three quad4, the automatic-normal group 1 now only
  holds the end elements 1 and 3, the middle element 2 is plain
  elastic in group 0. The end elements have a nonzero element_normal,
  1 0 and -1 0, the middle one keeps a zero normal but its group
  does not use it, so the run continues. With Poisson 0 the vertical
  cut-off planes of the end elements stay inactive under the vertical
  pull: disy 1 at the top, sigyy 1 everywhere. Pro 02-08-2026 gives the
  same element_normal and the same nodal values. )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  0 0
node 2  1 0
node 3  2 0
node 4  3 0
node 5  0 1
node 6  1 1
node 7  2 1
node 8  3 1
element 1  -quad4 1 2 5 6
element 2  -quad4 2 3 6 7
element 3  -quad4 3 4 7 8

element_group 1 1
element_group 3 1

group_type 0  -materi
group_materi_elasti_young 0  1.0

group_type 1  -materi
group_materi_elasti_young 1  1.0
group_materi_plasti_tension_direct 1  0.0
group_materi_plasti_tension_direct_normal_automatic 1  -yes

bounda_dof  0  -ra 1 2 3 4 -ra -velx -vely
bounda_dof  1  -ra 5 6 7 8 -ra -vely
bounda_time 1  1.

control_timestep 0  1. 1.
control_timestep_iterations 0 5

target_item    0  -element_normal 1 0
target_value   0  1. 1.e-10
target_item    1  -element_normal 3 0
target_value   1  -1. 1.e-10
target_item    2  -element_normal 2 0
target_value   2  0. 1.e-10
target_item    3  -element_normal 2 1
target_value   3  0. 1.e-10
target_item    4  -node_dof 6 -disy
target_value   4  1. 1.e-8
target_item    5  -node_dof 2 -sigyy
target_value   5  1. 1.e-8
target_item    6  -node_dof 7 -sigxx
target_value   6  0. 1.e-8
end_data
