( element_normal companion of element_normal2d_row_error1: the same
  single row of three quad4 on a support, now with the normal of the
  supported face given explicitly with
  group_materi_plasti_tension_direct_normal 0 1, as the input error
  advises. The row is pulled up by 1 at the top and opens freely on the
  horizontal cut-off plane: disy 1 at the top nodes, all stresses 0.
  Pro 02-08-2026 gives the same values. )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  0 0
node 2  1 0
node 3  2 0
node 4  3 0
node 5  0 1
node 6  1 1
node 7  2 1
node 8  3 1
element 1  -quad4 1 2 5 6
element 2  -quad4 2 3 6 7
element 3  -quad4 3 4 7 8

group_type 0  -materi
group_materi_elasti_young 0  1.0
group_materi_plasti_tension_direct 0  0.0
group_materi_plasti_tension_direct_normal 0  0. 1.

bounda_dof  0  -ra 1 2 3 4 -ra -velx -vely
bounda_dof  1  -ra 5 6 7 8 -ra -vely
bounda_time 1  1.

control_timestep 0  1. 1.
control_timestep_iterations 0 5

target_item    0  -node_dof 5 -disy
target_value   0  1. 1.e-8
target_item    1  -node_dof 7 -disy
target_value   1  1. 1.e-8
target_item    2  -node_dof 2 -sigyy
target_value   2  0. 1.e-8
target_item    3  -node_dof 6 -sigyy
target_value   3  0. 1.e-8
target_item    4  -node_dof 3 -sigxx
target_value   4  0. 1.e-8
end_data
