(
F5 W1 U6: linear_calculation_apply -yes (manual Professional 6.797): any
 control_plasti_apply is deleted and plasti_apply is set to -no. One quad4,
 E 1000, poisson 0, Mohr-Coulomb with c 0.001 (yields at once), top pushed
 down by 0.01 in one step. With -no the Professional 02-08-2026 gives
 the plastic sigyy -5.074; with -yes the elastic -10 (= analytic E eps).
 The Professional also deletes the group_materi_plasti_* records.)
echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_stress
end_initia
node 1 0 0
node 2 1 0
node 3 0 1
node 4 1 1
element 1 -quad4 1 2 3 4
group_type 0 -materi
group_materi_elasti_young 0 1000
group_materi_elasti_poisson 0 0.
bounda_dof 0 -ra 1 2 -ra -vely
bounda_dof 1 -ra 1 3 -ra -velx
bounda_dof 2 -ra 3 4 -ra -vely
bounda_time 2 0 0 1 -0.01
control_timestep 0 1 1
group_materi_plasti_mohr_coul 0 0.5 0.001 0.
control_plasti_apply 0 -yes
plasti_apply -yes
linear_calculation_apply -yes
target_item 0 -node_dof 4 -sigyy
target_value 0 -10. 1.e-8
end_data
