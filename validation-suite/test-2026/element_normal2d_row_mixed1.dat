( element_normal companion of element_normal2d_row_mixed_error1, with
  the roles of the two laws swapped: the tension plane has the explicit
  group_materi_plasti_tension_direct_normal 0 1, the Mohr-Coulomb plane
  uses group_materi_plasti_mohr_coul_direct_normal_automatic -yes. The
  automatic group 1 only holds the end elements 1 and 3 (element_normal
  1 0 and -1 0, nonzero); the middle element 2 is plain elastic in
  group 0 with a zero normal that no law uses, so the run continues.
  Tension cap 10 and cohesion 1 stay inactive under the vertical pull
  with Poisson 0: disy 1 at the top, sigyy 1 everywhere, sigxx 0. )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_displacement
materi_strain_total
materi_stress
end_initia

node 1  0 0
node 2  1 0
node 3  2 0
node 4  3 0
node 5  0 1
node 6  1 1
node 7  2 1
node 8  3 1
element 1  -quad4 1 2 5 6
element 2  -quad4 2 3 6 7
element 3  -quad4 3 4 7 8

element_group 1 1
element_group 3 1

group_type 0  -materi
group_materi_elasti_young 0  1.0

group_type 1  -materi
group_materi_elasti_young 1  1.0
group_materi_plasti_tension_direct 1  10.0
group_materi_plasti_tension_direct_normal 1  0. 1.
group_materi_plasti_mohr_coul_direct 1  0. 1. 0.
group_materi_plasti_mohr_coul_direct_normal_automatic 1  -yes

bounda_dof  0  -ra 1 2 3 4 -ra -velx -vely
bounda_dof  1  -ra 5 6 7 8 -ra -vely
bounda_time 1  1.

control_timestep 0  1. 1.
control_timestep_iterations 0 5

target_item    0  -element_normal 1 0
target_value   0  1. 1.e-10
target_item    1  -element_normal 3 0
target_value   1  -1. 1.e-10
target_item    2  -node_dof 6 -disy
target_value   2  1. 1.e-8
target_item    3  -node_dof 2 -sigyy
target_value   3  1. 1.e-8
target_item    4  -node_dof 7 -sigxx
target_value   4  0. 1.e-8
end_data
