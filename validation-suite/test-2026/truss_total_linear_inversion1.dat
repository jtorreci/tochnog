(F4 T6d C11, dynamic3 with an explicit group_truss_memory -total_linear.
 The truss inverts: the projected length must keep its sign (the old GNU
 took its absolute value and gave node 2 disx -5962.6). Target =
 Professional 02-08-2026 (6.044025070687e+01).)
echo -no
number_of_space_dimensions 1
materi_displacement
materi_velocity
materi_acceleration
end_initia

inertia_apply -yes

node 1  0
node 2  1
element 1  -truss 1 2

group_type 0  -truss
group_truss_area 0  1.0
group_truss_elasti_young 0  1.0
group_truss_density 0  2.0
group_truss_memory 0 -total_linear

bounda_dof    10  1 -accx
bounda_time   10  1.234

control_timestep      10  1.e-1 10.

target_item  0   -node_dof 2 -disx
target_value 0   60.44025070687 1.e-6
end_data
