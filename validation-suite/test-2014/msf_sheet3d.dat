( msf_sheet3d - sub-sprint materi_stress_force, lote 3 (integracion 3D hex27):
  SHEET PILE 3D - placa vertical de 4 elementos -hex27 (1 en espesor x=[0,1],
  4 en altura y=[0,4], 1 en ancho z=[0,2]). GOTCHA del GNU (documentado en
  manual-developer): el solve mixto 3D materi_stress + BiCG del GNU es
  degenerado para cargas de flexion (el cantilever con carga en punta da A*b~0
  y el solver se detiene en la iteracion 0 con x=0, o diverge con hex27) - por
  eso el test usa DEFORMACION PRESCRITA (Dirichlet puro, sin solve): el campo
  de FLEXION PURA u_y = kappa*(x-0.5)*y, u_x = -kappa*y^2/2, u_z = 0 (nu=0):
  sigma_yy = E*kappa*(x-0.5) EXACTO (el hex27 lo integra exacto) -> mom1 =
  E*kappa/12 = 0.0833333 const en cada seccion (+-y), nor = 0, she = 0.
  direction_include = altura (0 1 0): caras extremas +-y (|n*t_hat| minima,
  t_hat = normalizado(centroide - reference_point (1000,2,1)) ~ -x).
  Archivos materi_stress_force.500 (-all) y .501 (-primary). )

echo -no
number_of_space_dimensions 3
derivatives
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_stress
number_of_integration_points 27
end_initia

options_mesh -fixed_in_space -fixed_in_space -fixed_in_space
options_convection -no
options_inertia -no

