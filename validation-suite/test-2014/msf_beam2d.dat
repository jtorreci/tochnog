( msf_beam2d - sub-sprint materi_stress_force, lote 2 (integracion 2D):
  MENSULA 2D plane stress con 8 elementos -quad9 (1 en el espesor),
  L=8, h=1, empotrada en x=0 (columna izquierda: nodos 1, 18, 35),
  carga vertical P=1e-2 en el vertice derecho superior (nodo 51).
  reference_point (4,1000) -> direccion de espesor t ~ (0,-1) y caras
  extremas = las aristas verticales (las secciones). ESTATICA EXACTA:
  en la seccion a distancia (8-x) de la punta: she = P, mom = P*(8-x)
  (en x=0: 8e-2; en x=8: 0), nor ~ 0 (sin carga axial).
  DECISION CON EVIDENCIA (ver manual-developer): se usa quad9 y NO
  quad4 porque la malla quad4 de 1 elemento en espesor sufre shear
  locking (medido: mom = 0.23*P*(8-x) y she = 0.74*P - el campo de
  tensiones nodal no cumple el equilibrio de seccion); con quad9 el
  momento de seccion sale dentro del 1-3% de P*(8-x). La cizalla
  integrada de la formulacion mixta tiene polucion en las superficies
  libres (condicion de superficie libre debil) -> banda documentada
  |shes - P| < 0.5*P; el valor EXACTO de she se verifica en
  msf_shear (corte simple, campo uniforme). Archivo
  materi_stress_force.410 (=-all). )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_stress
number_of_integration_points 9
end_initia

options_mesh -fixed_in_space -fixed_in_space
options_convection -no
options_inertia -no

node 1  0.0. 0.0.
