( mstrain_compression_elast - elastic A/B twin of mstrain_compression
  (Sprint 10 lote 9): the SAME oedometer rig with the compression
  model (sig_yield = 1.0) but a load FAR below yield (vely -0.0001,
  10 steps, eps_zz = -0.00005, elastic sigzz = -0.067 << 1.0): the
  response is purely elastic and the dedicated plastic strain dof
  eppcozz stays exactly 0 (the plastic twin ends at -8.96e-05). )

echo -no
number_of_space_dimensions 2
derivatives
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_strain_plasti
materi_strain_plasti_compression
materi_stress
number_of_integration_points 4
end_initia

options_mesh -fixed_in_space -fixed_in_space

node 1  0. 0.
node 2  1. 0.
node 3  0. 1.
node 4  1. 1.

element 1  -quad4 1 2 3 4

element_group 1  0

group_type 0  -materi
group_materi_density 0  1.0
group_materi_elasti_young 0  1000.0
group_materi_elasti_poisson 0  0.3
group_materi_memory 0  -updated_without_rotation
group_materi_plasti_compression 0
                        1.0   ( sig_yield )

bounda_unknown 0  -ra 1 3 -ra -velx
bounda_time    0  0. 0. 100. 0.
bounda_unknown 1  -ra 2 4 -ra -velx
bounda_time    1  0. 0. 100. 0.
bounda_unknown 2  -ra 1 2 -ra -vely
bounda_time    2  0. 0. 100. 0.
bounda_unknown 3  -ra 3 4 -ra -vely
bounda_time    3  0. -0.0001 100. -0.0001

post_point 1  0.5 0.5

control_timestep 0  0.05 0.5
control_timestep_iterations 0  8

target_item  1  -post_point_dof 1 -eppcozz
target_value 1  0.0 0.0001
end_data
