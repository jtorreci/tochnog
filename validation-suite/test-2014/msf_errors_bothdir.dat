( msf_errors_bothdir: rewritten on 2026-10-05 after the rm incident.
  2D with direction_exclude AND direction_include together.
  Expected: rc=1 and the error 'are mutually exclusive', manual 6.913.
  EXPECTED_ERROR: are mutually exclusive )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_strain_total
materi_stress
end_initia

bounda_time  0  0 0 100 0
bounda_time  1  0 0 100 0
bounda_time  2  0 0.01 100 0.01
bounda_unknown  0  -ra 1 2 -ra -vely
bounda_unknown  1  -ra 1 2 -ra -velx
bounda_unknown  2  -ra 3 4 -ra -vely
control_print_materi_stress_force  400  -all
control_timestep  4  0.05 0.05
element  1  -quad4 1 2 3 4
element_group  1  0
group_materi_density  0  1
group_materi_elasti_poisson  0  0
group_materi_elasti_young  0  1000
group_materi_memory  0  -updated_without_rotation
group_type  0  -materi
node  1  0 0
node  2  1 0
node  3  0 1
node  4  1 1
options_convection   -no
options_inertia   -no
options_mesh   -fixed_in_space -fixed_in_space
options_processors   1
options_stabilization   -static
post_calcul   -materi_stress -force
post_calcul_materi_stress_force_direction_exclude   1 0
post_calcul_materi_stress_force_direction_include   0 1
post_calcul_materi_stress_force_element_group   0
post_calcul_materi_stress_force_reference_point   0.5 0.5
end_data
