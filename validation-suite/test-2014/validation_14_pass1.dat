node 8  0.02 0.04
node 9  0.04 0.04
node 10  0.00 0.07
node 11  0.02 0.07
node 12  0.04 0.07

element 1 -quad4 1 2 4 5
element 2 -quad4 2 3 5 6
element 3 -quad4 4 5 7 8
element 4 -quad4 5 6 8 9
element 5 -quad4 7 8 10 11
element 6 -quad4 8 9 11 12

(left edge)
geometry_line 0  0.00 0.00 0.00 0.07 1.e-5
(lower edge)
geometry_line 1  0.00 0.00 0.04 0.00 1.e-5
(upper edge)
geometry_line 2  0.00 0.07 0.04 0.07 1.e-5
(hole)
geometry_point 1 0.00 0.00 1.e-2
geometry_circle 1 0.00 0.00 1.e-2 1.e-5
geometry_projection_type 1 -project_inside
(all edges)
geometry_set 1 -geometry_line 0 -geometry_line 1 -geometry_line 0 -geometry_circle 1

bounda_dof 0  -geometry_line 0 -velx
bounda_time    0  0. 0. 1.e10 0.
bounda_dof 1  -geometry_line 1 -vely
bounda_time    1  0. 0. 1.e10 0.
bounda_dof 2  -geometry_line 2 -vely
bounda_time    2  0. -3.e-1 1.e10 -3.e-1

group_type 0  -materi
group_materi_elasti_young 0 1.e4
group_materi_memory 0  -total_linear
group_materi_plasti_druck_prag 0  0.30 5. 0.30

post_calcul -materi_strain_plasti -size_tot
post_point 0  0.01 0.0
print_filter 1  -post_point_dof 0 -eppyy

post_node 0 -node_rhside -sum -geometry_line 2

control_mesh_refine_globally           1  -h_refinement
control_mesh_refine_globally           2  -h_refinement
control_mesh_split                     5  -yes

control_mesh_delete_geometry          10  -geometry_point 1
control_mesh_delete_geometry_move_node 10  -yes

control_restart                       20  -yes

control_timestep                      30  5.e-6 1.e-3
(
control_print                         40  -control_repeat -time_current
)



