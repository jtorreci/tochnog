( tsup_damp: damping (6.1068) + factor (6.1075): prescribed u=v=(1e-4,-1e-3), k=(1000,100), c=(200,100), spatial factor 0.5 on stiffnesses. Per unit: fx = -(0.5*100*1e-4 + 100*1e-4) = -0.015; fy = +(0.5*1000*1e-3 + 200*1e-3) = +0.7. Node: (-0.0075, +0.35). )

echo -no
number_of_space_dimensions 2
derivatives
materi_velocity
materi_velocity_integrated
materi_displacement
materi_strain_total
materi_stress
end_initia

options_mesh -fixed_in_space -fixed_in_space
options_convection -no
options_inertia -no

node 1  0. 0.
