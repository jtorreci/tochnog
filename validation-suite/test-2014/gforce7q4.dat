( gforce7q4 - GNU conversion of the Professional's force7q4.dat
  (2D cantilever quad4, 1 element in thickness - the pathological
  bending case). L=100, h=10, 2 quad4 along x, 1 in thickness.
  Load on the right edge (fx,fy)=(-1.234,-10.) per unit length.
  Statics at the mid node 2 (x=50): N=-12.34, V=+100, M=-5000.

  Defect fixed 2026-09-16: the previous conversion used a single
  quad4 (1 3 9 7) with orphan mid-nodes, so the target
  `node_dof_calcul 2` referenced a node in no element and the run
  aborted. This reconstruction restores the Professional's two
  quad4 elements (1 2 4 5)/(2 3 5 6), the left-edge clamp and the
  edge load. GNU now returns the Professional statics exactly
  (-12.34 / +100 / -5000). See ProjectDocs/CORPUS-STALE-TARGETS.md. )

echo -no
number_of_space_dimensions 2
materi_velocity
materi_velocity_integrated
materi_displacement
materi_strain_total
materi_stress
number_of_integration_points 4
end_initia

options_mesh -fixed_in_space -fixed_in_space
options_convection -no
options_inertia -no

node 1  0. 0.
node 2  50. 0.
node 3  100. 0.
node 4  0. 10.
node 5  50. 10.
node 6  100. 10.

element 1  -quad4 1 2 4 5
element_group 1 0
element 2  -quad4 2 3 5 6
element_group 2 0

group_type 0  -materi
group_materi_density 0  1.0
group_materi_elasti_young 0  1e7
group_materi_elasti_poisson 0  0.3
group_materi_membrane 0  -yes
group_materi_memory 0  -total_linear

bounda_unknown 0  1 -vely
bounda_time    0  0. 0. 100. 0.
bounda_unknown 1  -ra 1 4 -ra -velx
bounda_time    1  0. 0. 100. 0.

geometry_line 1  100. 0.  100. 10.  1.e-4
force_edge 10  -1.234 -10.
force_edge_geometry 10  -geometry_line 1

post_calcul_materi_stress_force_element_group 0
post_calcul_materi_stress_force_reference_point 0. 1000.
post_calcul -materi_stress -force

control_timestep 30  1.  1.0

( targets by positional index: 0=norx 1=nory 2=nors 3=shex 4=shey
  5=shes 6=momx 7=momy 8=moms )
target_item 10  -node_dof_calcul 2  1
target_value 10  -12.34 1.e-2
target_item 20  -node_dof_calcul 2  4
target_value 20  +100. 1.e-2
target_item 30  -node_dof_calcul 2  7
target_value 30  -5000. 1.e-2
end_data
