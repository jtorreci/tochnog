control_timestep  0  1 100
element  1  -quad4 1 2 3 4
element  2  -quad4 2 4 5 7
element  3  -quad4 5 6 7 8
element_group  1  0
element_group  2  10
element_group  3  20
force_gravity   0 -1
groundflow_density   1
group_groundflow_capacity  0  1
group_groundflow_capacity  20  1
group_groundflow_permeability  0  0.1 0.1
group_groundflow_permeability  20  1e-06 1e-06
group_interface  10  -yes
group_interface_groundflow_capacity  10  1
group_interface_groundflow_permeability  10  1
group_interface_groundflow_total_pressure_tension  10  0.001 5
group_type  0  -groundflow
group_type  10  -groundflow
group_type  20  -groundflow
node  1  0 0
node  2  1 0
node  3  0 1
node  4  1 1
node  5  2 0
node  6  3 0
node  7  2 1
node  8  3 1
options_convection   -no
options_mesh   -fixed_in_space -fixed_in_space
options_processors   1
options_stabilization   -static
print_filter  0  -node_dof -all -pres
target_item  0  -node_dof 5 -pres
target_value  0  2 0.01
node_dof  1  0 0 0 0 0
