( gforce7 - GNU conversion of the Professional force7.dat
  (2D cantilever quad9, L=100 h=10, edge load q=(-1.234,-10)/unit
  at x=100, consistent nodal loads 1/6-2/3-1/6). Statics at x=50
  node 2: N=-12.34, V=-100, M=-5000. )

echo -no
number_of_space_dimensions 2
derivatives
materi_velocity
materi_velocity_integrated
materi_displacement
materi_strain_total
materi_stress
number_of_integration_points 9
end_initia

options_mesh -fixed_in_space -fixed_in_space
options_convection -no
options_inertia -no

node 1  0. 0.
node 2  50. 0.
node 3  100. 0.
node 4  0. 5.
node 5  50. 5.
node 6  100. 5.
node 7  0. 10.
node 8  50. 10.
node 9  100. 10.

element 1  -quad9 1 2 3 4 5 6 7 8 9
element_group 1 0

group_type 0  -materi
group_materi_elasti_young 0  1.e7
group_materi_elasti_poisson 0  0.0
group_materi_memory 0  -total_linear

bounda_unknown 0  -ra 1 4 7 -ra -velx -vely
bounda_time    0  0. 0. 100. 0.

( edge h=10: corner 1/6 = -2.0567, -16.667; mid 2/3 = -8.2267, -66.667 )
bounda_force 1  3 -velx
bounda_time  1  0. -2.0567 100. -2.0567
bounda_force 2  3 -vely
bounda_time  2  0. -16.667 100. -16.667
bounda_force 3  6 -velx
bounda_time  3  0. -8.2267 100. -8.2267
bounda_force 4  6 -vely
bounda_time  4  0. -66.667 100. -66.667
bounda_force 5  9 -velx
bounda_time  5  0. -2.0567 100. -2.0567
bounda_force 6  9 -vely
bounda_time  6  0. -16.667 100. -16.667

post_calcul_materi_stress_force_element_group 0
post_calcul_materi_stress_force_reference_point 50. 1000.
post_calcul_materi_stress_force_thickness_switch -yes
post_calcul -materi_stress -force

control_timestep 30  1.  1.0

target_item 10  -node_dof_calcul 2 1
target_value 10  -12.34 1.e-2
target_item 20  -node_dof_calcul 2 4
target_value 20  100. 1.
target_item 30  -node_dof_calcul 2 7
target_value 30  -5000. 50.
end_data
