( tsup_3d: support_edge_normal on a 3D FACE - per unit area.
  One hex8 cube 1x1x1, bottom face z=0 on support k_n=100, k_t=0.
  The four bottom nodes are prescribed uy=-0.001, dt=1: the support
  force per node = k*u*A/4 = 100*0.001*0.25 = 0.025 EXACT in +z. )

echo -no
number_of_space_dimensions 3
derivatives
materi_velocity
materi_velocity_integrated
materi_displacement
materi_strain_total
materi_stress
number_of_integration_points 8
end_initia

options_mesh -fixed_in_space -fixed_in_space -fixed_in_space
options_convection -no
options_inertia -no

node 1  0. 0. 0.
node 2  1. 0. 0.
node 3  0. 1. 0.
node 4  1. 1. 0.
node 5  0. 0. 1.
node 6  1. 0. 1.
node 7  0. 1. 1.
node 8  1. 1. 1.

element 1  -hex8 1 2 3 4 5 6 7 8
element_group 1 0

group_type 0  -materi
group_materi_elasti_young 0  1.e7
group_materi_elasti_poisson 0  0.0
group_materi_memory 0  -total_linear

node_support_edge_normal_force 1  0. 0. 0.
node_support_edge_normal_force 2  0. 0. 0.
node_support_edge_normal_force 3  0. 0. 0.
node_support_edge_normal_force 4  0. 0. 0.

support_edge_normal 1  100. 0.
support_edge_normal_geometry 1  1 2 3 4

bounda_unknown 0  -ra 1 2 3 4 -ra -velx -vely -velz
bounda_time    0  0. -0.001 100. -0.001

control_timestep 1  1. 1.0

target_item 10  -node_support_edge_normal_force 1 2
target_value 10  0.025 1.e-4
target_item 20  -node_support_edge_normal_force 4 2
target_value 20  0.025 1.e-4
end_data
